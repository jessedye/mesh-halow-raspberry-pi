#!/bin/bash
# halow-bridge-net — render the role-appropriate NAT + DHCP for the Pi.
# Called by halowctl role; also usable standalone with --check to VALIDATE
# the generated configs without applying them (nft -c + dnsmasq --test),
# which is how bridge mode is bench-tested while the live cutover is still
# blocked on a second HaLow AP / would sever eth0 management.
#
#   halow-bridge-net render <gateway|bridge>   -> print nft + dnsmasq to
#                                                 /run/halow-role/ (tmpfs)
#   halow-bridge-net check  <gateway|bridge>    render + validate, exit!=0
#   halow-bridge-net apply  <gateway|bridge>    render, validate, install,
#                                               reload nft + dnsmasq
set -euo pipefail
ENV=/etc/halow/halow.env
# shellcheck disable=SC1090
[ -r "$ENV" ] && . "$ENV"
HALOW_IF=${HALOW_IF:-halow0}
UPLINK=${HALOW_BRIDGE_UPLINK:-halow}
ETH=${HALOW_BRIDGE_ETH:-mgmt}
OUT=/run/halow-role
mkdir -p "$OUT"

# The downlink subnet the Pi hands out in bridge mode. mesh-2g already
# owns 10.42.0.0/24 (wlan0), so reuse it as the 2.4GHz downlink; eth0
# downlink (when enabled) gets 10.43.0.0/24 so the two never collide.
WLAN_SUBNET=10.42.0
ETH_SUBNET=10.43.0

uplink_iface() { [ "$UPLINK" = wifi ] && echo wlan0 || echo "$HALOW_IF"; }
downlink_ifaces() {
  # In bridge/halow-uplink the 2.4GHz AP (wlan0) is the downlink. In
  # bridge/wifi-uplink wlan0 is busy being the uplink, so eth0 must be
  # the downlink. eth=downlink adds eth0 in the halow-uplink case too.
  if [ "$UPLINK" = wifi ]; then echo eth0
  elif [ "$ETH" = downlink ]; then echo "wlan0 eth0"
  else echo wlan0; fi
}

render_gateway_nft() {
  cat > "$OUT/nftables.conf" <<'EOF'
# Generated by halow-bridge-net (role=gateway) — do not edit.
table ip halow
delete table ip halow
table ip halow {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related counter accept
    ct status dnat counter accept
    iifname "halow0" counter accept
    iifname "eth0" oifname "halow0" counter accept
    iifname "wlan0" counter accept
  }
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    tcp dport 443 counter redirect to :8443
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.117.0.0/24 oifname "eth0" counter masquerade
  }
}
EOF
}

render_bridge_nft() {
  local up dls
  up=$(uplink_iface)
  dls=$(downlink_ifaces)
  {
    echo "# Generated by halow-bridge-net (role=bridge uplink=$UPLINK eth=$ETH) — do not edit."
    echo "table ip halow"
    echo "delete table ip halow"
    echo "table ip halow {"
    echo "  chain forward {"
    echo "    type filter hook forward priority 0; policy drop;"
    echo "    ct state established,related counter accept"
    for d in $dls; do
      echo "    iifname \"$d\" oifname \"$up\" counter accept   # downlink -> uplink"
    done
    echo "  }"
    echo "  chain prerouting {"
    echo "    type nat hook prerouting priority dstnat; policy accept;"
    echo "    tcp dport 443 counter redirect to :8443"
    echo "  }"
    echo "  chain postrouting {"
    echo "    type nat hook postrouting priority srcnat; policy accept;"
    # masquerade every downlink subnet toward the uplink
    for d in $dls; do
      case "$d" in
        wlan0) echo "    ip saddr ${WLAN_SUBNET}.0/24 oifname \"$up\" counter masquerade" ;;
        eth0)  echo "    ip saddr ${ETH_SUBNET}.0/24 oifname \"$up\" counter masquerade" ;;
      esac
    done
    echo "  }"
    echo "}"
  } > "$OUT/nftables.conf"
}

render_gateway_dnsmasq() {
  # gateway role uses the shipped /etc/dnsmasq.d/halow.conf verbatim
  cp /etc/dnsmasq.d/halow.conf "$OUT/dnsmasq-halow.conf" 2>/dev/null || true
}

render_bridge_dnsmasq() {
  # DHCP on each downlink; DNS handed out is 1.1.1.1 (the uplink resolves
  # onward). The HaLow subnet's own dnsmasq (halow.conf) is untouched.
  local dls; dls=$(downlink_ifaces)
  { for d in $dls; do
      case "$d" in
        wlan0) echo "interface=wlan0"; echo "bind-dynamic"
               echo "dhcp-range=set:wlan,${WLAN_SUBNET}.50,${WLAN_SUBNET}.200,12h"
               echo "dhcp-option=tag:wlan,option:router,${WLAN_SUBNET}.1"
               echo "dhcp-option=tag:wlan,option:dns-server,1.1.1.1,8.8.8.8" ;;
        eth0)  echo "interface=eth0"; echo "bind-dynamic"
               echo "dhcp-range=set:eth,${ETH_SUBNET}.50,${ETH_SUBNET}.200,12h"
               echo "dhcp-option=tag:eth,option:router,${ETH_SUBNET}.1"
               echo "dhcp-option=tag:eth,option:dns-server,1.1.1.1,8.8.8.8" ;;
      esac
    done
    echo "dhcp-authoritative"
  } > "$OUT/dnsmasq-bridge.conf"
}

render() {
  case "$1" in
    gateway) render_gateway_nft; render_gateway_dnsmasq ;;
    bridge)  render_bridge_nft;  render_bridge_dnsmasq ;;
    *) echo "role must be gateway|bridge"; exit 2 ;;
  esac
}

check() {
  render "$1"
  local rc=0
  nft -c -f "$OUT/nftables.conf" && echo "nft OK ($1)" || { echo "nft INVALID"; rc=1; }
  if [ -f "$OUT/dnsmasq-bridge.conf" ]; then
    dnsmasq --test --conf-file="$OUT/dnsmasq-bridge.conf" 2>&1 | tail -1
  fi
  return $rc
}

case "${1:-}" in
  render) render "${2:?role}" && echo "rendered to $OUT" ;;
  check)  check "${2:?role}" ;;
  apply)
    role=${2:?role}
    check "$role" >/dev/null || { echo "config invalid — NOT applied"; exit 1; }
    install -m644 "$OUT/nftables.conf" /etc/halow/nftables-halow.conf
    if [ "$role" = bridge ]; then
      install -m644 "$OUT/dnsmasq-bridge.conf" /etc/dnsmasq.d/halow-bridge.conf
    else
      rm -f /etc/dnsmasq.d/halow-bridge.conf
    fi
    nft -f /etc/halow/nftables-halow.conf
    systemctl reload-or-restart dnsmasq 2>/dev/null || systemctl restart dnsmasq
    echo "applied role=$role"
    ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
