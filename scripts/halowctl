#!/bin/bash
# halowctl — HaLow AP control for the Pi gateway.
#   halowctl status            chip, interface, AP state, stations
#   halowctl profiles          list tuning profiles and the active one
#   halowctl check-compat [profile=N|channel=N width=M ssid=S]  pinned-set verdicts (read-only JSON)
#   halowctl set-profile NAME [confirm=1]  switch profile (guarded: refuses off-pinned-set retunes while stations/reservations exist)
#   halowctl set KEY=VAL ... [confirm=1]   override channel=N width=M ssid=S (persisted; same guard)
#   halowctl gen               regenerate hostapd conf from env+profile
#   halowctl stations          associated STA dump
#   halowctl join-log [mac|--all|--selftest]  association forensics (read-only)
#   halowctl health            station health ladder view (read-only)
#   halowctl driver status|rebuild [KVER]|hold|unhold  kernel-upgrade interlock
#   halowctl mode ap|sta       broadcast the SSID, or join it as a station
#   halowctl probe             reload the driver and report chip probe result
#   halowctl restart|stop      control the AP service
#   halowctl set-passphrase    new HaLow SAE passphrase on stdin (8-63 chars)
#   halowctl wifi-config K=V.. 2.4G AP: ssid=NAME channel=1-11
#   halowctl wifi-passphrase   new 2.4G WPA2 passphrase on stdin
#   halowctl dhcp-config K=V.. start=IP end=IP lease=12h dns=1.1.1.1,8.8.8.8
#   halowctl forwards CMD      list | add proto=tcp ext=N dest=IP:PORT | del ext=N proto=tcp | apply
# Config: /etc/halow/halow.env (+ halow-profiles.json alongside this repo copy)
set -euo pipefail

ENV=/etc/halow/halow.env
PROFILES=/etc/halow/halow-profiles.json
CONF=/etc/halow/hostapd_s1g.conf
[ -f "$ENV" ] || { echo "missing $ENV (copy config/halow.env.example)"; exit 1; }
# halow.env is root-only (it holds the SAE passphrase) — climb once if needed
[ -r "$ENV" ] || exec sudo "$0" "$@"
# shellcheck disable=SC1090
. "$ENV"

jqp() { python3 -c "import json,sys;d=json.load(open('$PROFILES'));print($1)"; }

resolve() { # -> CH OP WIDTH PRIM
  local prof=${HALOW_PROFILE:-$(jqp "d['default']")}
  CH=$(jqp "d['profiles']['$prof']['channel']")
  OP=$(jqp "d['profiles']['$prof']['op_class']")
  WIDTH=$(jqp "d['profiles']['$prof']['width_mhz']")
  PRIM=$(jqp "d['profiles']['$prof']['prim_chwidth']")
  # explicit overrides win; op_class re-derived from width
  if [ -n "${HALOW_CHANNEL:-}" ]; then CH=$HALOW_CHANNEL; fi
  if [ -n "${HALOW_WIDTH:-}" ]; then
    WIDTH=$HALOW_WIDTH
    case "$WIDTH" in
      1) OP=68; PRIM=0;; 2) OP=69; PRIM=1;; 4) OP=70; PRIM=1;; 8) OP=71; PRIM=1;;
      *) echo "width must be 1|2|4|8"; exit 1;;
    esac
  fi
}

# Pinned-scan guard: the ESP32 STAs scan only the five (freq,width) pairs in
# /etc/halow/pinned-scan.json. Compatibility is frequency+width, NEVER channel
# number (the node's 1 MHz grid is integer-MHz; the US regdb's is x.5 MHz).
# Mode 0 prints the full JSON verdict; mode 1 (guard) is silent on pass and
# prints a refusal + exit 4 when the candidate leaves the pinned set while
# stations or reservations exist. Missing pinned file / non-US = fail closed.
compat_check() { # compat_check 0|1 [profile=N] [channel=N] [width=M] [ssid=S]
  local mode=$1; shift
  local stations res
  stations=$(iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null | grep -c '^Station' || true)
  res=$(grep -c '^dhcp-host=' /etc/dnsmasq.d/halow-reservations.conf 2>/dev/null || true)
  env CUR_PROFILE="${HALOW_PROFILE:-}" CUR_CHANNEL="${HALOW_CHANNEL:-}" \
      CUR_WIDTH="${HALOW_WIDTH:-}" CUR_SSID="${HALOW_SSID:-}" \
      CUR_COUNTRY="${HALOW_COUNTRY:-US}" STATIONS="$stations" \
      RESERVATIONS="$res" GUARD="$mode" \
      python3 - "$PROFILES" /etc/halow/pinned-scan.json "$@" <<'PY'
import json, os, sys

profiles_path, pinned_path = sys.argv[1], sys.argv[2]
args = dict(a.split("=", 1) for a in sys.argv[3:] if "=" in a)
guard = os.environ.get("GUARD") == "1"
stations = int(os.environ.get("STATIONS") or 0)
reservations = int(os.environ.get("RESERVATIONS") or 0)
armed = stations > 0 or reservations > 0
country = (os.environ.get("CUR_COUNTRY") or "US").strip() or "US"

err = None
pinned_pairs, pinned_ssid = [], None
try:
    pj = json.load(open(pinned_path))
    pinned_pairs = [(float(c["centre_freq_mhz"]), int(c["width_mhz"]))
                    for c in pj["channels"]]
    pinned_ssid = pj.get("ssid")
except Exception as e:
    err = f"pinned set unavailable ({pinned_path}: {e.__class__.__name__})"
if err is None and country != "US":
    err = f"country {country} != US: no frequency math for the pinned set"

prof = json.load(open(profiles_path))
cur_prof = os.environ.get("CUR_PROFILE") or prof["default"]

def freq(ch):
    return 902.0 + 0.5 * ch  # verified against every US regdb row [M]

def effective(profile=None, channel=None, width=None):
    p = profile or cur_prof
    ch, w = int(prof["profiles"][p]["channel"]), int(prof["profiles"][p]["width_mhz"])
    if profile is None:  # current state: env overrides win (resolve() precedence)
        if os.environ.get("CUR_CHANNEL"): ch = int(os.environ["CUR_CHANNEL"])
        if os.environ.get("CUR_WIDTH"):   w = int(os.environ["CUR_WIDTH"])
    if channel is not None: ch = int(channel)
    if width is not None:   w = int(width)
    return ch, w

def grid(width):
    return "/".join(f"{pf:g}" for pf, pw in pinned_pairs if pw == width)

def verdict(ch, w, ssid):
    if err:
        return False, err
    f = freq(ch)
    if not any(abs(f - pf) < 0.001 and w == pw for pf, pw in pinned_pairs):
        return False, (f"{f:g} MHz @ {w} MHz not in pinned set "
                       f"(1 MHz grid: {grid(1)}; 4 MHz: {grid(4)})")
    if ssid is not None and pinned_ssid and ssid != pinned_ssid:
        return False, f"ssid '{ssid}' != pinned ssid '{pinned_ssid}'"
    return True, ""

out = {"presence": {"stations": stations, "reservations": reservations,
                    "guard_armed": armed},
       "profiles": {}}
for name, p in prof["profiles"].items():
    ch, w = int(p["channel"]), int(p["width_mhz"])
    ok, _ = verdict(ch, w, None)
    out["profiles"][name] = {"channel": ch, "width_mhz": w,
                             "centre_freq_mhz": freq(ch), "compatible": ok}
ach, aw = effective()
aok, _ = verdict(ach, aw, None)
out["active"] = {"profile": cur_prof, "channel": ach, "width_mhz": aw,
                 "centre_freq_mhz": freq(ach), "compatible": aok}

cand_ok, reason, desc = True, "", ""
if args:
    try:
        if "profile" in args:
            name = args["profile"]
            if name not in prof["profiles"]:
                raise ValueError(f"unknown profile {name}")
            ch, w = effective(profile=name)
            desc = f"{name} ({freq(ch):g} MHz @ {w} MHz)"
        else:
            ch, w = effective(channel=args.get("channel"), width=args.get("width"))
            desc = f"channel {ch} ({freq(ch):g} MHz @ {w} MHz)"
        cand_ok, reason = verdict(ch, w, args.get("ssid"))
        if args.get("ssid") is not None:
            desc += f" ssid '{args['ssid']}'"
        cand = {"channel": ch, "width_mhz": w, "centre_freq_mhz": freq(ch),
                "compatible": cand_ok}
        if "profile" in args: cand["profile"] = args["profile"]
        if args.get("ssid") is not None: cand["ssid"] = args["ssid"]
        if not cand_ok: cand["reason"] = reason
        out["candidate"] = cand
    except (ValueError, KeyError) as e:
        cand_ok, reason = False, f"invalid candidate: {e}"
        desc = " ".join(f"{k}={v}" for k, v in args.items())
        out["candidate"] = {"compatible": False, "reason": reason}

if guard:
    if args and not cand_ok and armed:
        sys.stderr.write(
            f"REFUSED: {desc}: {reason}.\n"
            f"{stations} station(s) associated, {reservations} reservation(s) on"
            " file: applying this strands every pinned ESP32 STA with symptoms"
            " identical to a dead radio (/etc/halow/pinned-scan.json).\n"
            "Re-run with confirm=1 to apply anyway.\n")
        sys.exit(4)
    sys.exit(0)
print(json.dumps(out, indent=1))
PY
}

gen() {
  resolve
  umask 077
  # STA-side config is always generated too; the mode decides which service runs
  cat > /etc/halow/wpa_supplicant_s1g.conf <<EOF
# Generated by halowctl — join an existing HaLow network as a station.
ctrl_interface=/var/run/wpa_supplicant_s1g
country=${HALOW_COUNTRY:-US}
network={
    ssid="${HALOW_SSID}"
    sae_password="${HALOW_PASSPHRASE}"
    key_mgmt=SAE
    ieee80211w=2
}
EOF
  cat > "$CONF" <<EOF
# Generated by halowctl $(date -Is) — do not edit; edit $ENV instead.
interface=${HALOW_IF:-halow0}
driver=nl80211
ssid=${HALOW_SSID}
# S1G channels are presented to hostapd as mapped 5 GHz channels — hw_mode
# must be 'a' or it falls back to 11b and cannot resolve the frequency.
hw_mode=a
ieee80211ah=1
channel=${CH}
op_class=${OP}
country_code=${HALOW_COUNTRY:-US}
s1g_prim_chwidth=${PRIM}
wpa=2
wpa_key_mgmt=SAE
rsn_pairwise=CCMP
ieee80211w=2
sae_password=${HALOW_PASSPHRASE}
ctrl_interface=/var/run/hostapd_s1g
ctrl_interface_group=halow-ui
# Join forensics (halow-join-log): stdout->journal at debugging level so
# per-STA SAE commit/confirm records are captured; syslog stays at INFO.
# Deliberately NOT the -d/-dd flags — at -dd wpa_printf can dump EAPOL
# key material. These conf keys are the bounded, secret-safe knob.
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=1
EOF
  echo "generated $CONF: ${HALOW_SSID} ch=$CH op_class=$OP width=${WIDTH}MHz"
}

case "${1:-status}" in
  gen) gen ;;
  profiles)
    active=${HALOW_PROFILE:-$(jqp "d['default']")}
    python3 - "$PROFILES" "$active" /etc/halow/pinned-scan.json <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); act=sys.argv[2]
try:
    pj=json.load(open(sys.argv[3]))
    pin=[(float(c["centre_freq_mhz"]),int(c["width_mhz"])) for c in pj["channels"]]
except Exception:
    pin=None
for n,p in d['profiles'].items():
    m=' *' if n==act else '  '
    tag=''
    if pin is not None:
        f=902.0+0.5*p['channel']
        if not any(abs(f-pf)<0.001 and int(p['width_mhz'])==pw for pf,pw in pin):
            tag='  STRANDS-PINNED'
    print(f"{m}{n:11s} {p['width_mhz']}MHz ch{p['channel']:>3} op{p['op_class']}  {p['phy_note']}{tag}")
PY
    ;;
  check-compat)
    shift
    compat_check 0 "$@"
    ;;
  set-profile)
    n=${2:?usage: halowctl set-profile NAME [confirm=1]}
    jqp "d['profiles']['$n']" >/dev/null || { echo "unknown profile $n"; exit 1; }
    if [ "${3:-}" != "confirm=1" ]; then
      compat_check 1 "profile=$n" || exit 4
    fi
    sudo sed -i "s/^HALOW_PROFILE=.*/HALOW_PROFILE=$n/; s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=/; s/^HALOW_WIDTH=.*/HALOW_WIDTH=/" "$ENV"
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  set)
    shift
    confirm=0; pairs=()
    for kv in "$@"; do
      case "$kv" in
        confirm=1) confirm=1 ;;                 # consumed, never persisted
        *) pairs+=("$kv") ;;
      esac
    done
    [ ${#pairs[@]} -gt 0 ] || { echo "usage: halowctl set channel=N|width=M|ssid=S [confirm=1]"; exit 1; }
    for kv in "${pairs[@]}"; do
      case "${kv%%=*}" in
        channel|width|ssid) ;;
        *) echo "unknown key ${kv%%=*} (channel|width|ssid)"; exit 1;;
      esac
    done
    if [ "$confirm" != 1 ]; then
      compat_check 1 "${pairs[@]}" || exit 4
    fi
    for kv in "${pairs[@]}"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        channel) sudo sed -i "s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=$v/" "$ENV";;
        width)   sudo sed -i "s/^HALOW_WIDTH=.*/HALOW_WIDTH=$v/" "$ENV";;
        ssid)    sudo sed -i "s/^HALOW_SSID=.*/HALOW_SSID=$v/" "$ENV";;
      esac
    done
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  stations)
    iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null || echo "no stations / interface down"
    ;;
  join-log)
    shift
    exec /usr/local/bin/halow-join-log "$@"
    ;;
  driver)
    sub=${2:-status}
    case "$sub" in
      status)
        if [ -f /var/lib/halow/kernel-guard.json ]; then
          python3 - <<'PY'
import json
d = json.load(open("/var/lib/halow/kernel-guard.json"))
print(f"state: {d['state']}  (checked {d['checked_at']})")
print(f"running:   {d['running_kernel']}  module: {d['running_has_module']}")
print(f"next boot: {d['next_boot_kernel']}  module: {d['next_boot_has_module']}")
if d.get("holds"): print("HELD:", " ".join(d["holds"]), "- 'halowctl driver unhold' after fixing")
lr = d.get("last_rebuild")
if lr: print(f"last rebuild: {lr['kernel']} ok={lr['ok']} {lr['seconds']}s at {lr['at']}")
PY
        else
          # box without the guard: fall back to the direct check
          K=$(uname -r)
          compgen -G "/lib/modules/$K/updates/morse.ko*" >/dev/null || \
          compgen -G "/lib/modules/$K/extra/morse.ko*" >/dev/null || \
            echo "!! NO morse.ko FOR RUNNING KERNEL $K"
          echo "(no kernel-guard state file — guard not deployed?)"
        fi
        ;;
      rebuild) sudo /usr/local/bin/halow-kernel-guard rebuild "${3:-$(uname -r)}" ;;
      hold)    sudo /usr/local/bin/halow-kernel-guard hold ;;
      unhold)  sudo /usr/local/bin/halow-kernel-guard unhold ;;
      *) echo "usage: halowctl driver status|rebuild [KVER]|hold|unhold"; exit 1 ;;
    esac
    ;;
  health)
    python3 - <<'PY'
import json, time
try:
    h = json.load(open("/var/lib/halow/station-health.json"))["stations"]
except Exception:
    print("no health records yet (halow-mon writes them once a minute)")
    raise SystemExit(0)
if not h:
    print("no stations known")
    raise SystemExit(0)
fmt = "%Y-%m-%d %H:%M:%S"
print(f"{'MAC':18} {'STATE':15} {'IP':14} {'INTERVAL':>8} {'LAST ASSOC':20} DETAIL")
for mac, r in sorted(h.items()):
    last = (time.strftime(fmt, time.localtime(r["last_seen_assoc"]))
            if r.get("last_seen_assoc") else "never")
    print(f"{mac:18} {str(r.get('state')):15} {str(r.get('ip') or '-'):14} "
          f"{str(r.get('expected_interval_s')) + 's':>8} {last:20} "
          f"{r.get('detail') or ''}")
PY
    ;;
  mode)
    m=${2:?usage: halowctl mode ap|sta}
    case "$m" in ap|sta) ;; *) echo "mode must be ap or sta"; exit 1;; esac
    grep -q "^HALOW_MODE=" "$ENV" || echo "HALOW_MODE=ap" | sudo tee -a "$ENV" >/dev/null
    sudo sed -i "s/^HALOW_MODE=.*/HALOW_MODE=$m/" "$ENV"
    sudo "$0" gen
    if [ "$m" = ap ]; then
      sudo systemctl disable --now halow-sta >/dev/null 2>&1 || true
      sudo systemctl enable halow-ap >/dev/null 2>&1
      sudo systemctl restart halow-ap 2>/dev/null || echo "AP starts when halow0 appears"
    else
      sudo systemctl disable --now halow-ap >/dev/null 2>&1 || true
      sudo systemctl enable halow-sta >/dev/null 2>&1
      sudo systemctl restart halow-sta 2>/dev/null || echo "STA starts when halow0 appears"
    fi
    ;;
  dhcp-reserve)
    RES=/etc/dnsmasq.d/halow-reservations.conf
    sub=${2:-list}
    case "$sub" in
      list) grep -oP "dhcp-host=\K.*" "$RES" 2>/dev/null || echo "(none)" ;;
      add)
        shift 2; MAC=""; IP=""; NAME=""
        for kv in "$@"; do case "${kv%%=*}" in
          mac) MAC=${kv#*=};; ip) IP=${kv#*=};; name) NAME=${kv#*=};; esac; done
        [[ "$MAC" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]] || { echo "bad mac"; exit 1; }
        [[ "$IP" =~ ^10\.117\.0\.[0-9]+$ ]] || { echo "ip must be 10.117.0.x"; exit 1; }
        [[ -z "$NAME" || "$NAME" =~ ^[A-Za-z0-9-]+$ ]] || { echo "bad name"; exit 1; }
        sudo touch "$RES"
        sudo sed -i "/dhcp-host=${MAC}/Id" "$RES"
        echo "dhcp-host=${MAC},${IP}${NAME:+,$NAME}" | sudo tee -a "$RES" >/dev/null
        sudo systemctl restart dnsmasq && echo "reserved ${IP} for ${MAC}"
        ;;
      del)
        shift 2; MAC=${1#mac=}
        [[ "$MAC" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]] || { echo "bad mac"; exit 1; }
        sudo sed -i "/dhcp-host=${MAC}/Id" "$RES" 2>/dev/null
        sudo systemctl restart dnsmasq && echo "released ${MAC}"
        ;;
      *) echo "usage: halowctl dhcp-reserve list|add mac= ip= [name=]|del mac="; exit 1 ;;
    esac
    ;;
  capture)
    SECS=${2:-10}
    [[ "$SECS" =~ ^[0-9]+$ ]] && [ "$SECS" -ge 3 ] && [ "$SECS" -le 30 ] || { echo "seconds 3-30"; exit 1; }
    OUT=/var/lib/halow/capture.pcap
    sudo timeout "$SECS" tcpdump -i "${HALOW_IF:-halow0}" -c 5000 -w "$OUT" 2>&1 | tail -2
    sudo chmod 644 "$OUT" 2>/dev/null
    ls -la "$OUT" 2>/dev/null || echo "no capture produced"
    ;;
  rate)
    P=/sys/module/morse/parameters
    case "${2:-show}" in
      show)
        echo "enable_fixed_rate=$(cat $P/enable_fixed_rate) fixed_mcs=$(cat $P/fixed_mcs) fixed_bw=$(cat $P/fixed_bw)"
        echo "NOTE: experimental test knobs; runtime effect unverified — restart halow-ap after changing, and always 'rate auto' + restart to restore (a control that drifts is the bug)"
        ;;
      auto) echo 0 | sudo tee $P/enable_fixed_rate >/dev/null && echo "fixed rate off" ;;
      set)
        shift 2
        for kv in "$@"; do
          k=${kv%%=*}; v=${kv#*=}
          [[ "$v" =~ ^[0-9]+$ ]] || { echo "numeric values only"; exit 1; }
          case "$k" in
            mcs) echo "$v" | sudo tee $P/fixed_mcs >/dev/null ;;
            bw)  echo "$v" | sudo tee $P/fixed_bw >/dev/null ;;
            *) echo "unknown key $k (mcs|bw)"; exit 1 ;;
          esac
        done
        echo 1 | sudo tee $P/enable_fixed_rate >/dev/null
        echo "fixed rate on: $(cat $P/fixed_mcs) mcs, bw code $(cat $P/fixed_bw) — restart halow-ap to apply"
        ;;
      *) echo "usage: halowctl rate show|set mcs=N bw=N|auto"; exit 1 ;;
    esac
    ;;
  diff)
    REPO=${2:-/home/pi/mesh-halow-raspberry-pi}
    rc=0
    for pair in "config/halow-profiles.json:/etc/halow/halow-profiles.json" \
                "config/pinned-scan.json:/etc/halow/pinned-scan.json" \
                "config/nftables-halow.conf:/etc/halow/nftables-halow.conf" \
                "config/morse.conf:/etc/modprobe.d/morse.conf"; do
      r="$REPO/${pair%%:*}"; l="${pair#*:}"
      if ! diff -q "$r" "$l" >/dev/null 2>&1; then
        echo "DRIFT: $l vs $r"; diff -u "$r" "$l" 2>&1 | head -15; rc=1
      fi
    done
    # env: compare key sets only, never values (the passphrase lives there)
    comm -3 <(grep -oP "^[A-Z_]+(?==)" "$REPO/config/halow.env.example" | sort) \
            <(sudo grep -oP "^[A-Z_]+(?==)" /etc/halow/halow.env | sort) | \
      sed "s/^\t/extra key on device: /; s/^[^ \t]/missing key on device: &/" | grep . && rc=1
    [ $rc -eq 0 ] && echo "no drift"
    exit $rc
    ;;
  snapshot)
    D=/var/lib/halow/config-snapshot-$(date +%Y%m%d-%H%M%S)
    sudo mkdir -p "$D"
    sudo cp /etc/halow/halow.env /etc/halow/halow-profiles.json /etc/halow/pinned-scan.json \
            /etc/halow/nftables-halow.conf \
            /etc/halow/forwards.json /etc/modprobe.d/morse.conf /etc/dnsmasq.d/halow*.conf "$D/" 2>/dev/null
    sudo chmod 700 "$D"
    echo "snapshot: $D (root-only; includes secrets — never copy into the repo)"
    ;;
  chip)
    morse_cli -i "${HALOW_IF:-halow0}" version 2>&1
    morse_cli -i "${HALOW_IF:-halow0}" stats 2>&1 | head -40
    ;;
  probe)
    sudo sh -c "rmmod morse 2>/dev/null; modprobe morse"
    sleep 4
    if journalctl -k -q --no-pager -g "morse" -n 10 | grep -q "probe failed"; then
      echo "PROBE FAILED — last kernel lines:"
      journalctl -k -q --no-pager -g "morse" -n 6
      exit 1
    fi
    echo "PROBE OK:"; journalctl -k -q --no-pager -g "morse" -n 6
    ;;
  wifi-ap)
    case "${2:-status}" in
      on)  sudo nmcli con up mesh-2g ;;
      off) sudo nmcli con down mesh-2g ;;
      status) nmcli -t -f NAME,DEVICE,STATE con show --active | grep mesh-2g || echo "mesh-2g down" ;;
      *) echo "usage: halowctl wifi-ap on|off|status"; exit 1 ;;
    esac
    ;;
  set-passphrase)
    # stdin, never argv: argv is visible in ps and shell history
    PASS=$(head -c 256)
    n=${#PASS}
    [ "$n" -ge 8 ] && [ "$n" -le 63 ] || { echo "passphrase must be 8-63 chars"; exit 1; }
    sudo env NEWPASS="$PASS" python3 - <<'PY'
import os, re
p = "/etc/halow/halow.env"
s = open(p).read()
s = re.sub(r"(?m)^HALOW_PASSPHRASE=.*$", "HALOW_PASSPHRASE=" + os.environ["NEWPASS"], s)
open(p, "w").write(s)
PY
    sudo "$0" gen && sudo systemctl restart halow-ap 2>/dev/null || true
    echo "halow passphrase updated"
    ;;
  wifi-config)
    shift
    for kv in "$@"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        ssid)    sudo nmcli con modify mesh-2g 802-11-wireless.ssid "$v" ;;
        channel) [[ "$v" =~ ^([1-9]|1[01])$ ]] || { echo "channel 1-11"; exit 1; }
                 sudo nmcli con modify mesh-2g 802-11-wireless.channel "$v" ;;
        *) echo "unknown key $k (ssid|channel)"; exit 1 ;;
      esac
    done
    nmcli -t -f NAME,STATE con show --active | grep -q mesh-2g && sudo nmcli con up mesh-2g >/dev/null
    echo "wifi config updated"
    ;;
  wifi-passphrase)
    PASS=$(head -c 256)
    n=${#PASS}
    [ "$n" -ge 8 ] && [ "$n" -le 63 ] || { echo "passphrase must be 8-63 chars"; exit 1; }
    sudo nmcli con modify mesh-2g 802-11-wireless-security.psk "$PASS"
    nmcli -t -f NAME,STATE con show --active | grep -q mesh-2g && sudo nmcli con up mesh-2g >/dev/null
    echo "wifi passphrase updated"
    ;;
  dhcp-config)
    shift
    CONF=/etc/dnsmasq.d/halow.conf
    START=$(grep -oP "dhcp-range=\K[0-9.]+" "$CONF"); END=$(grep -oP "dhcp-range=[0-9.]+,\K[0-9.]+" "$CONF")
    LEASE=$(grep -oP "dhcp-range=[0-9.]+,[0-9.]+,\K\S+" "$CONF"); DNS=$(grep -oP "option:dns-server,\K\S+" "$CONF")
    for kv in "$@"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        start) [[ "$v" =~ ^10\.117\.0\.[0-9]+$ ]] || { echo "start must be 10.117.0.x"; exit 1; }; START=$v ;;
        end)   [[ "$v" =~ ^10\.117\.0\.[0-9]+$ ]] || { echo "end must be 10.117.0.x"; exit 1; }; END=$v ;;
        lease) [[ "$v" =~ ^[0-9]+[hm]$ ]] || { echo "lease like 12h or 90m"; exit 1; }; LEASE=$v ;;
        dns)   [[ "$v" =~ ^[0-9.,]+$ ]] || { echo "dns is comma-separated IPs"; exit 1; }; DNS=$v ;;
        *) echo "unknown key $k (start|end|lease|dns)"; exit 1 ;;
      esac
    done
    sudo tee "$CONF" >/dev/null <<EOF
# Managed by halowctl dhcp-config — edits here are overwritten.
interface=halow0
bind-dynamic
dhcp-range=${START},${END},${LEASE}
dhcp-option=option:router,10.117.0.1
dhcp-option=option:dns-server,${DNS}
dhcp-option=option:ntp-server,10.117.0.1
dhcp-authoritative
log-dhcp
EOF
    sudo systemctl restart dnsmasq && echo "dhcp: ${START}-${END} lease ${LEASE} dns ${DNS}"
    ;;
  forwards)
    FWD=/etc/halow/forwards.json
    sub=${2:-list}
    [ -f "$FWD" ] || echo "[]" | sudo tee "$FWD" >/dev/null
    case "$sub" in
      list) cat "$FWD" ;;
      add|del)
        shift 2
        sudo env OP="$sub" ARGS="$*" python3 - <<'PY'
import json, os, re, sys
fwd = "/etc/halow/forwards.json"
rules = json.load(open(fwd))
kv = dict(a.split("=", 1) for a in os.environ["ARGS"].split())
op = os.environ["OP"]
proto = kv.get("proto", "tcp")
if proto not in ("tcp", "udp"): sys.exit("proto must be tcp|udp")
ext = int(kv["ext"])
if not 1 <= ext <= 65535: sys.exit("ext port out of range")
if op == "add":
    dest = kv["dest"]
    if not re.match(r"^10\.117\.0\.\d+:\d+$", dest):
        sys.exit("dest must be 10.117.0.x:port")
    rules = [r for r in rules if not (r["proto"] == proto and r["ext"] == ext)]
    rules.append({"proto": proto, "ext": ext, "dest": dest})
else:
    rules = [r for r in rules if not (r["proto"] == proto and r["ext"] == ext)]
json.dump(rules, open(fwd, "w"), indent=1)
print(f"{op} ok — {len(rules)} rule(s)")
PY
        sudo chgrp halow-ui "$FWD" && sudo chmod 640 "$FWD"
        sudo "$0" forwards apply
        ;;
      apply)
        {
          echo "table ip halow_fwd"
          echo "delete table ip halow_fwd"
          echo "table ip halow_fwd {"
          echo "  chain prerouting {"
          echo "    type nat hook prerouting priority -101; policy accept;"
          python3 -c '
import json
for r in json.load(open("/etc/halow/forwards.json")):
    ip, port = r["dest"].split(":")
    print("    iifname \"eth0\" %s dport %s dnat to %s:%s"
          % (r["proto"], r["ext"], ip, port))'
          echo "  }"
          echo "}"
        } | sudo nft -f - && echo "forwards applied"
        ;;
      *) echo "usage: halowctl forwards list|add|del|apply"; exit 1 ;;
    esac
    ;;
  restart) sudo systemctl restart halow-ap ;;
  stop) sudo systemctl stop halow-ap ;;
  status)
    K=$(uname -r)
    if [ -f /var/lib/halow/kernel-guard.json ]; then
      GS=$(python3 -c "import json;print(json.load(open('/var/lib/halow/kernel-guard.json'))['state'])" 2>/dev/null || echo unknown)
      [ "$GS" = ok ] || echo "!! KERNEL GUARD: state=$GS — see 'halowctl driver status'"
    else
      # compgen, not ls: 'ls A* B*' fails when EITHER glob is empty, and the
      # module lives only in updates/ — that false-fired on every healthy boot.
      compgen -G "/lib/modules/$K/updates/morse.ko*" >/dev/null || \
      compgen -G "/lib/modules/$K/extra/morse.ko*" >/dev/null || \
        echo "!! NO morse.ko FOR RUNNING KERNEL $K — a kernel upgrade orphaned the driver; run install.sh --driver-only (or --prebuilt) BEFORE the next reboot"
    fi
    echo "== interface"; ip -br addr show "${HALOW_IF:-halow0}" 2>/dev/null || echo "  ${HALOW_IF:-halow0}: ABSENT (driver not probed?)"
    echo "== AP service"; systemctl is-active halow-ap 2>/dev/null || true
    echo "== config"; resolve; echo "  ssid=${HALOW_SSID} profile=${HALOW_PROFILE:-default} ch=$CH op=$OP width=${WIDTH}MHz"
    echo "== chip"; dmesg | grep -iE "morse.*(fw|chip)" | tail -2 || true
    echo "== stations"; iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null | grep -E "^Station|signal:|tx bitrate|rx bitrate" || echo "  none"
    ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
