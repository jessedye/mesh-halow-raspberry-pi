#!/bin/bash
# halowctl — HaLow AP control for the Pi gateway.
#   halowctl status            chip, interface, AP state, stations
#   halowctl profiles          list tuning profiles and the active one
#   halowctl check-compat [profile=N|channel=N width=M ssid=S]  pinned-set verdicts (read-only JSON)
#   halowctl set-profile NAME [confirm=1]  switch profile (guarded: refuses off-pinned-set retunes while stations/reservations exist)
#   halowctl set KEY=VAL ... [confirm=1]   override channel=N width=M ssid=S (persisted; same guard)
#   halowctl gen               regenerate hostapd conf from env+profile
#   halowctl stations          associated STA dump
#   halowctl join-log [mac|--all|--selftest]  association forensics (read-only)
#   halowctl health            station health ladder view (read-only)
#   halowctl driver status|rebuild [KVER]|hold|unhold  kernel-upgrade interlock
#   halowctl role show|check|set-gateway|set-bridge [uplink=halow|wifi] [eth=mgmt|downlink] [hold=N]|commit  bridged mode
#   halowctl mode ap|sta       broadcast the SSID, or join it as a station
#   halowctl probe             reload the driver and report chip probe result
#   halowctl restart|stop      control the AP service
#   halowctl set-passphrase    new HaLow SAE passphrase on stdin (8-63 chars)
#   halowctl wifi-config K=V.. 2.4G AP: ssid=NAME channel=1-11
#   halowctl wifi-passphrase   new 2.4G WPA2 passphrase on stdin
#   halowctl dhcp-config K=V.. start=IP end=IP lease=12h dns=1.1.1.1,8.8.8.8
#   halowctl forwards CMD      list | add proto=tcp ext=N dest=IP:PORT | del ext=N proto=tcp | apply
# Config: /etc/halow/halow.env (+ halow-profiles.json alongside this repo copy)
set -euo pipefail

ENV=/etc/halow/halow.env
PROFILES=/etc/halow/halow-profiles.json
CONF=/etc/halow/hostapd_s1g.conf
# restore runs on a fresh card where halow.env does not exist yet — it must
# skip the env guard/source (it recreates the file). Every other subcommand
# needs the env and the sudo-climb.
if [ "${1:-}" = restore ]; then
  [ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
else
  [ -f "$ENV" ] || { echo "missing $ENV (copy config/halow.env.example)"; exit 1; }
  # halow.env is root-only (it holds the SAE passphrase) — climb once if needed
  [ -r "$ENV" ] || exec sudo "$0" "$@"
  # shellcheck disable=SC1090
  . "$ENV"
fi

jqp() { python3 -c "import json,sys;d=json.load(open('$PROFILES'));print($1)"; }

resolve() { # -> CH OP WIDTH PRIM
  local prof=${HALOW_PROFILE:-$(jqp "d['default']")}
  CH=$(jqp "d['profiles']['$prof']['channel']")
  OP=$(jqp "d['profiles']['$prof']['op_class']")
  WIDTH=$(jqp "d['profiles']['$prof']['width_mhz']")
  PRIM=$(jqp "d['profiles']['$prof']['prim_chwidth']")
  # explicit overrides win; op_class re-derived from width
  if [ -n "${HALOW_CHANNEL:-}" ]; then CH=$HALOW_CHANNEL; fi
  if [ -n "${HALOW_WIDTH:-}" ]; then
    WIDTH=$HALOW_WIDTH
    case "$WIDTH" in
      1) OP=68; PRIM=0;; 2) OP=69; PRIM=1;; 4) OP=70; PRIM=1;; 8) OP=71; PRIM=1;;
      *) echo "width must be 1|2|4|8"; exit 1;;
    esac
  fi
}

# Pinned-scan guard: the ESP32 STAs scan only the five (freq,width) pairs in
# /etc/halow/pinned-scan.json. Compatibility is frequency+width, NEVER channel
# number (the node's 1 MHz grid is integer-MHz; the US regdb's is x.5 MHz).
# Mode 0 prints the full JSON verdict; mode 1 (guard) is silent on pass and
# prints a refusal + exit 4 when the candidate leaves the pinned set while
# stations or reservations exist. Missing pinned file / non-US = fail closed.
compat_check() { # compat_check 0|1 [profile=N] [channel=N] [width=M] [ssid=S]
  local mode=$1; shift
  local stations res
  stations=$(iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null | grep -c '^Station' || true)
  res=$(grep -c '^dhcp-host=' /etc/dnsmasq.d/halow-reservations.conf 2>/dev/null || true)
  env CUR_PROFILE="${HALOW_PROFILE:-}" CUR_CHANNEL="${HALOW_CHANNEL:-}" \
      CUR_WIDTH="${HALOW_WIDTH:-}" CUR_SSID="${HALOW_SSID:-}" \
      CUR_COUNTRY="${HALOW_COUNTRY:-US}" STATIONS="$stations" \
      RESERVATIONS="$res" GUARD="$mode" \
      python3 - "$PROFILES" /etc/halow/pinned-scan.json "$@" <<'PY'
import json, os, sys

profiles_path, pinned_path = sys.argv[1], sys.argv[2]
args = dict(a.split("=", 1) for a in sys.argv[3:] if "=" in a)
guard = os.environ.get("GUARD") == "1"
stations = int(os.environ.get("STATIONS") or 0)
reservations = int(os.environ.get("RESERVATIONS") or 0)
armed = stations > 0 or reservations > 0
country = (os.environ.get("CUR_COUNTRY") or "US").strip() or "US"

err = None
pinned_pairs, pinned_ssid = [], None
try:
    pj = json.load(open(pinned_path))
    pinned_pairs = [(float(c["centre_freq_mhz"]), int(c["width_mhz"]))
                    for c in pj["channels"]]
    pinned_ssid = pj.get("ssid")
except Exception as e:
    err = f"pinned set unavailable ({pinned_path}: {e.__class__.__name__})"
if err is None and country != "US":
    err = f"country {country} != US: no frequency math for the pinned set"

prof = json.load(open(profiles_path))
cur_prof = os.environ.get("CUR_PROFILE") or prof["default"]

def freq(ch):
    return 902.0 + 0.5 * ch  # verified against every US regdb row [M]

def effective(profile=None, channel=None, width=None):
    p = profile or cur_prof
    ch, w = int(prof["profiles"][p]["channel"]), int(prof["profiles"][p]["width_mhz"])
    if profile is None:  # current state: env overrides win (resolve() precedence)
        if os.environ.get("CUR_CHANNEL"): ch = int(os.environ["CUR_CHANNEL"])
        if os.environ.get("CUR_WIDTH"):   w = int(os.environ["CUR_WIDTH"])
    if channel is not None: ch = int(channel)
    if width is not None:   w = int(width)
    return ch, w

def grid(width):
    return "/".join(f"{pf:g}" for pf, pw in pinned_pairs if pw == width)

def verdict(ch, w, ssid):
    if err:
        return False, err
    f = freq(ch)
    if not any(abs(f - pf) < 0.001 and w == pw for pf, pw in pinned_pairs):
        return False, (f"{f:g} MHz @ {w} MHz not in pinned set "
                       f"(1 MHz grid: {grid(1)}; 4 MHz: {grid(4)})")
    if ssid is not None and pinned_ssid and ssid != pinned_ssid:
        return False, f"ssid '{ssid}' != pinned ssid '{pinned_ssid}'"
    return True, ""

out = {"presence": {"stations": stations, "reservations": reservations,
                    "guard_armed": armed},
       "profiles": {}}
for name, p in prof["profiles"].items():
    ch, w = int(p["channel"]), int(p["width_mhz"])
    ok, _ = verdict(ch, w, None)
    out["profiles"][name] = {"channel": ch, "width_mhz": w,
                             "centre_freq_mhz": freq(ch), "compatible": ok}
ach, aw = effective()
aok, _ = verdict(ach, aw, None)
out["active"] = {"profile": cur_prof, "channel": ach, "width_mhz": aw,
                 "centre_freq_mhz": freq(ach), "compatible": aok}

cand_ok, reason, desc = True, "", ""
if args:
    try:
        if "profile" in args:
            name = args["profile"]
            if name not in prof["profiles"]:
                raise ValueError(f"unknown profile {name}")
            ch, w = effective(profile=name)
            desc = f"{name} ({freq(ch):g} MHz @ {w} MHz)"
        else:
            ch, w = effective(channel=args.get("channel"), width=args.get("width"))
            desc = f"channel {ch} ({freq(ch):g} MHz @ {w} MHz)"
        cand_ok, reason = verdict(ch, w, args.get("ssid"))
        if args.get("ssid") is not None:
            desc += f" ssid '{args['ssid']}'"
        cand = {"channel": ch, "width_mhz": w, "centre_freq_mhz": freq(ch),
                "compatible": cand_ok}
        if "profile" in args: cand["profile"] = args["profile"]
        if args.get("ssid") is not None: cand["ssid"] = args["ssid"]
        if not cand_ok: cand["reason"] = reason
        out["candidate"] = cand
    except (ValueError, KeyError) as e:
        cand_ok, reason = False, f"invalid candidate: {e}"
        desc = " ".join(f"{k}={v}" for k, v in args.items())
        out["candidate"] = {"compatible": False, "reason": reason}

if guard:
    if args and not cand_ok and armed:
        sys.stderr.write(
            f"REFUSED: {desc}: {reason}.\n"
            f"{stations} station(s) associated, {reservations} reservation(s) on"
            " file: applying this strands every pinned ESP32 STA with symptoms"
            " identical to a dead radio (/etc/halow/pinned-scan.json).\n"
            "Re-run with confirm=1 to apply anyway.\n")
        sys.exit(4)
    sys.exit(0)
print(json.dumps(out, indent=1))
PY
}

gen() {
  resolve
  umask 077
  # STA-side config is always generated too; the mode decides which service runs
  cat > /etc/halow/wpa_supplicant_s1g.conf <<EOF
# Generated by halowctl — join an existing HaLow network as a station.
ctrl_interface=/var/run/wpa_supplicant_s1g
country=${HALOW_COUNTRY:-US}
network={
    ssid="${HALOW_SSID}"
    sae_password="${HALOW_PASSPHRASE}"
    key_mgmt=SAE
    ieee80211w=2
}
EOF
  cat > "$CONF" <<EOF
# Generated by halowctl $(date -Is) — do not edit; edit $ENV instead.
interface=${HALOW_IF:-halow0}
driver=nl80211
ssid=${HALOW_SSID}
# S1G channels are presented to hostapd as mapped 5 GHz channels — hw_mode
# must be 'a' or it falls back to 11b and cannot resolve the frequency.
hw_mode=a
ieee80211ah=1
channel=${CH}
op_class=${OP}
country_code=${HALOW_COUNTRY:-US}
s1g_prim_chwidth=${PRIM}
wpa=2
wpa_key_mgmt=SAE
rsn_pairwise=CCMP
ieee80211w=2
sae_password=${HALOW_PASSPHRASE}
ctrl_interface=/var/run/hostapd_s1g
ctrl_interface_group=halow-ui
# Join forensics (halow-join-log): stdout->journal at debugging level so
# per-STA SAE commit/confirm records are captured; syslog stays at INFO.
# Deliberately NOT the -d/-dd flags — at -dd wpa_printf can dump EAPOL
# key material. These conf keys are the bounded, secret-safe knob.
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=1
EOF
  echo "generated $CONF: ${HALOW_SSID} ch=$CH op_class=$OP width=${WIDTH}MHz"
}

case "${1:-status}" in
  gen) gen ;;
  profiles)
    active=${HALOW_PROFILE:-$(jqp "d['default']")}
    python3 - "$PROFILES" "$active" /etc/halow/pinned-scan.json <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); act=sys.argv[2]
try:
    pj=json.load(open(sys.argv[3]))
    pin=[(float(c["centre_freq_mhz"]),int(c["width_mhz"])) for c in pj["channels"]]
except Exception:
    pin=None
for n,p in d['profiles'].items():
    m=' *' if n==act else '  '
    tag=''
    if pin is not None:
        f=902.0+0.5*p['channel']
        if not any(abs(f-pf)<0.001 and int(p['width_mhz'])==pw for pf,pw in pin):
            tag='  STRANDS-PINNED'
    print(f"{m}{n:11s} {p['width_mhz']}MHz ch{p['channel']:>3} op{p['op_class']}  {p['phy_note']}{tag}")
PY
    ;;
  check-compat)
    shift
    compat_check 0 "$@"
    ;;
  set-profile)
    n=${2:?usage: halowctl set-profile NAME [confirm=1]}
    jqp "d['profiles']['$n']" >/dev/null || { echo "unknown profile $n"; exit 1; }
    if [ "${3:-}" != "confirm=1" ]; then
      compat_check 1 "profile=$n" || exit 4
    fi
    sudo sed -i "s/^HALOW_PROFILE=.*/HALOW_PROFILE=$n/; s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=/; s/^HALOW_WIDTH=.*/HALOW_WIDTH=/" "$ENV"
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  set)
    shift
    confirm=0; pairs=()
    for kv in "$@"; do
      case "$kv" in
        confirm=1) confirm=1 ;;                 # consumed, never persisted
        *) pairs+=("$kv") ;;
      esac
    done
    [ ${#pairs[@]} -gt 0 ] || { echo "usage: halowctl set channel=N|width=M|ssid=S [confirm=1]"; exit 1; }
    for kv in "${pairs[@]}"; do
      case "${kv%%=*}" in
        channel|width|ssid) ;;
        *) echo "unknown key ${kv%%=*} (channel|width|ssid)"; exit 1;;
      esac
    done
    if [ "$confirm" != 1 ]; then
      compat_check 1 "${pairs[@]}" || exit 4
    fi
    for kv in "${pairs[@]}"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        channel) sudo sed -i "s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=$v/" "$ENV";;
        width)   sudo sed -i "s/^HALOW_WIDTH=.*/HALOW_WIDTH=$v/" "$ENV";;
        ssid)    sudo sed -i "s/^HALOW_SSID=.*/HALOW_SSID=$v/" "$ENV";;
      esac
    done
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  stations)
    iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null || echo "no stations / interface down"
    ;;
  join-log)
    shift
    exec /usr/local/bin/halow-join-log "$@"
    ;;
  role)
    # Bridged mode (user request 2026-08-05): the Pi as a remote bridge.
    #   gateway (default): halow0 AP + eth0 upstream NAT (today's role)
    #   bridge uplink=halow: halow0 STA joins another gateway's mesh;
    #                        downlink mesh-2g AP (+ eth0 if eth=downlink)
    #   bridge uplink=wifi:  wlan0 STA joins an upstream WiFi (nmcli
    #                        profile bridge-uplink); downlink eth0
    # SAFETY: a role switch reconfigures the interface you may be managing
    # through. set-bridge arms a dead-man rollback — unless 'role commit'
    # runs within hold= seconds (default 300), the Pi restores gateway.
    sub=${2:-show}
    setkey() { sudo sed -i "s|^$1=.*|$1=$2|" "$ENV"; grep -q "^$1=" "$ENV" || echo "$1=$2" | sudo tee -a "$ENV" >/dev/null; }
    case "$sub" in
      show)
        R=$(grep -oP '^HALOW_ROLE=\K.*' "$ENV" 2>/dev/null || echo gateway)
        U=$(grep -oP '^HALOW_BRIDGE_UPLINK=\K.*' "$ENV" 2>/dev/null || echo halow)
        E=$(grep -oP '^HALOW_BRIDGE_ETH=\K.*' "$ENV" 2>/dev/null || echo mgmt)
        echo "role: $R"
        [ "$R" = bridge ] && echo "  uplink: $U   eth0: $E"
        if systemctl is-active halow-role-rollback.timer >/dev/null 2>&1; then
          echo "  ROLLBACK ARMED — run 'halowctl role commit' to keep this role"
        fi
        echo "  services: halow-ap=$(systemctl is-active halow-ap 2>/dev/null||true) halow-sta=$(systemctl is-active halow-sta 2>/dev/null||true)"
        ;;
      check)
        # render + validate BOTH role configs without applying (bench-safe)
        sudo /usr/local/bin/halow-bridge-net check gateway
        sudo /usr/local/bin/halow-bridge-net check bridge
        ;;
      wifi-uplink)
        shift 2
        SSID=""; for kv in "$@"; do [ "${kv%%=*}" = ssid ] && SSID=${kv#*=}; done
        [ -n "$SSID" ] || { echo "usage: halowctl role wifi-uplink ssid=NAME (psk on stdin)"; exit 1; }
        PSK=$(head -c 128)
        sudo nmcli con delete bridge-uplink >/dev/null 2>&1 || true
        sudo nmcli con add type wifi ifname wlan0 con-name bridge-uplink ssid "$SSID" >/dev/null
        sudo nmcli con modify bridge-uplink wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PSK" connection.autoconnect no >/dev/null
        echo "bridge-uplink profile set for SSID '$SSID' (psk stored in NM, not echoed)"
        ;;
      set-gateway)
        setkey HALOW_ROLE gateway
        sudo /usr/local/bin/halow-bridge-net apply gateway
        sudo systemctl stop halow-sta 2>/dev/null || true
        sudo nmcli con down bridge-uplink 2>/dev/null || true
        sudo systemctl stop halow-role-rollback.timer halow-role-rollback.service 2>/dev/null || true
        echo "role: gateway restored"
        ;;
      set-bridge)
        shift 2
        HOLD=300; UPL=""
        for kv in "$@"; do case "${kv%%=*}" in
          uplink) setkey HALOW_BRIDGE_UPLINK "${kv#*=}"; UPL=${kv#*=};;
          eth)    setkey HALOW_BRIDGE_ETH "${kv#*=}";;
          hold)   HOLD=${kv#*=};;
        esac; done
        UPL=${UPL:-$(grep -oP '^HALOW_BRIDGE_UPLINK=\K.*' "$ENV" 2>/dev/null||echo halow)}
        setkey HALOW_ROLE bridge
        if ! sudo /usr/local/bin/halow-bridge-net check bridge >/dev/null 2>&1; then
          setkey HALOW_ROLE gateway
          echo "REFUSED: bridge config failed validation; role unchanged"; exit 1
        fi
        sudo systemd-run --on-active="${HOLD}s" --unit=halow-role-rollback \
          /usr/local/bin/halowctl role set-gateway >/dev/null 2>&1 || true
        echo "ROLLBACK ARMED (${HOLD}s) — reverts to gateway unless 'halowctl role commit'"
        if [ "$UPL" = wifi ]; then
          sudo systemctl stop halow-ap 2>/dev/null || true
          sudo nmcli con up bridge-uplink 2>/dev/null || echo "  (bridge-uplink profile missing — run 'role wifi-uplink' first)"
        else
          sudo "$0" mode sta >/dev/null 2>&1 || echo "  (halow STA start deferred — needs an upstream mesh AP)"
        fi
        sudo /usr/local/bin/halow-bridge-net apply bridge
        echo "role: bridge (uplink=$UPL) — verify the uplink got an address, then 'halowctl role commit'"
        ;;
      commit)
        sudo systemctl stop halow-role-rollback.timer halow-role-rollback.service 2>/dev/null || true
        systemctl reset-failed halow-role-rollback.service 2>/dev/null || true
        echo "role committed — rollback disarmed"
        ;;
      *) echo "usage: halowctl role show|check|wifi-uplink ssid=..|set-gateway|set-bridge [uplink=halow|wifi] [eth=mgmt|downlink] [hold=N]|commit"; exit 1 ;;
    esac
    ;;
  node)
    NJ=/etc/halow/nodes.json
    sub=${2:-list}
    case "$sub" in
      list)
        sudo python3 - <<'PY'
import json
try:
    d = json.load(open("/etc/halow/nodes.json"))
except Exception:
    print("no nodes.json"); raise SystemExit(0)
print(f"{'NAME':10} {'URL':28} {'MAC':18} {'INTERVAL':>9} TOKEN")
for n in d.get("nodes", []):
    iv = n.get("expected_interval_s")
    print(f"{n.get('name',''):10} {n.get('url',''):28} "
          f"{n.get('mac') or '-':18} {str(iv) if iv else 'learn':>9} "
          f"{'(set)' if n.get('token') else '(unset)'}")
PY
        ;;
      add)
        shift 2
        # token on stdin, never argv (visible in ps) — the set-passphrase
        # pattern. Empty stdin keeps/reuses the token existing entries share.
        TOK=$(head -c 256)
        sudo env ARGS="$*" NEWTOK="$TOK" python3 - <<'PY'
import json, os, re, sys
p = "/etc/halow/nodes.json"
kv = dict(a.split("=", 1) for a in os.environ["ARGS"].split() if "=" in a)
name, mac = kv.get("name", ""), kv.get("mac", "").lower()
url = kv.get("url", "")
if not re.fullmatch(r"[A-Za-z0-9-]+", name):
    sys.exit("bad name (A-Za-z0-9-)")
if mac and not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
    sys.exit("bad mac")
if url and not re.match(r"^https?://", url):
    sys.exit("bad url")
try:
    d = json.load(open(p))
except Exception:
    d = {"nodes": []}
tok = os.environ.get("NEWTOK", "").strip()
if not tok:
    tok = next((n.get("token", "") for n in d["nodes"] if n.get("token")), "")
entry = next((n for n in d["nodes"] if n.get("name") == name), None)
if entry is None:
    entry = {"name": name}
    d["nodes"].append(entry)
if url: entry["url"] = url
if mac: entry["mac"] = mac
entry.setdefault("mac", "")
if "interval" in kv:
    entry["expected_interval_s"] = int(kv["interval"])
entry.setdefault("expected_interval_s", None)
if tok: entry["token"] = tok
tmp = p + ".tmp"
open(tmp, "w").write(json.dumps(d, indent=1))
os.chmod(tmp, 0o640)
os.replace(tmp, p)
print(f"node {name} upserted ({len(d['nodes'])} configured)")
PY
        sudo chgrp halow-ui "$NJ" 2>/dev/null
        ;;
      del)
        shift 2
        sudo env ARGS="$*" python3 - <<'PY'
import json, os, sys
p = "/etc/halow/nodes.json"
kv = dict(a.split("=", 1) for a in os.environ["ARGS"].split() if "=" in a)
d = json.load(open(p))
before = len(d["nodes"])
d["nodes"] = [n for n in d["nodes"]
              if not (n.get("name") == kv.get("name")
                      or (kv.get("mac") and n.get("mac") == kv["mac"].lower()))]
if len(d["nodes"]) == before:
    sys.exit("no matching node")
tmp = p + ".tmp"
open(tmp, "w").write(json.dumps(d, indent=1))
os.chmod(tmp, 0o640)
os.replace(tmp, p)
print(f"deleted ({len(d['nodes'])} remain)")
PY
        sudo chgrp halow-ui "$NJ" 2>/dev/null
        ;;
      *) echo "usage: halowctl node list|add name= [mac=] [url=] [interval=]|del name=|mac= (token on stdin for add)"; exit 1 ;;
    esac
    ;;
  driver)
    sub=${2:-status}
    case "$sub" in
      status)
        if [ -f /var/lib/halow/kernel-guard.json ]; then
          python3 - <<'PY'
import json
d = json.load(open("/var/lib/halow/kernel-guard.json"))
print(f"state: {d['state']}  (checked {d['checked_at']})")
print(f"running:   {d['running_kernel']}  module: {d['running_has_module']}")
print(f"next boot: {d['next_boot_kernel']}  module: {d['next_boot_has_module']}")
if d.get("holds"): print("HELD:", " ".join(d["holds"]), "- 'halowctl driver unhold' after fixing")
lr = d.get("last_rebuild")
if lr: print(f"last rebuild: {lr['kernel']} ok={lr['ok']} {lr['seconds']}s at {lr['at']}")
PY
        else
          # box without the guard: fall back to the direct check
          K=$(uname -r)
          compgen -G "/lib/modules/$K/updates/morse.ko*" >/dev/null || \
          compgen -G "/lib/modules/$K/extra/morse.ko*" >/dev/null || \
            echo "!! NO morse.ko FOR RUNNING KERNEL $K"
          echo "(no kernel-guard state file — guard not deployed?)"
        fi
        ;;
      rebuild) sudo /usr/local/bin/halow-kernel-guard rebuild "${3:-$(uname -r)}" ;;
      hold)    sudo /usr/local/bin/halow-kernel-guard hold ;;
      unhold)  sudo /usr/local/bin/halow-kernel-guard unhold ;;
      *) echo "usage: halowctl driver status|rebuild [KVER]|hold|unhold"; exit 1 ;;
    esac
    ;;
  health)
    python3 - <<'PY'
import json, time
try:
    h = json.load(open("/var/lib/halow/station-health.json"))["stations"]
except Exception:
    print("no health records yet (halow-mon writes them once a minute)")
    raise SystemExit(0)
if not h:
    print("no stations known")
    raise SystemExit(0)
fmt = "%Y-%m-%d %H:%M:%S"
print(f"{'MAC':18} {'STATE':15} {'IP':14} {'INTERVAL':>8} {'LAST ASSOC':20} DETAIL")
for mac, r in sorted(h.items()):
    last = (time.strftime(fmt, time.localtime(r["last_seen_assoc"]))
            if r.get("last_seen_assoc") else "never")
    print(f"{mac:18} {str(r.get('state')):15} {str(r.get('ip') or '-'):14} "
          f"{str(r.get('expected_interval_s')) + 's':>8} {last:20} "
          f"{r.get('detail') or ''}")
PY
    ;;
  mode)
    m=${2:?usage: halowctl mode ap|sta}
    case "$m" in ap|sta) ;; *) echo "mode must be ap or sta"; exit 1;; esac
    grep -q "^HALOW_MODE=" "$ENV" || echo "HALOW_MODE=ap" | sudo tee -a "$ENV" >/dev/null
    sudo sed -i "s/^HALOW_MODE=.*/HALOW_MODE=$m/" "$ENV"
    sudo "$0" gen
    if [ "$m" = ap ]; then
      sudo systemctl disable --now halow-sta >/dev/null 2>&1 || true
      sudo systemctl enable halow-ap >/dev/null 2>&1
      sudo systemctl restart halow-ap 2>/dev/null || echo "AP starts when halow0 appears"
    else
      sudo systemctl disable --now halow-ap >/dev/null 2>&1 || true
      sudo systemctl enable halow-sta >/dev/null 2>&1
      sudo systemctl restart halow-sta 2>/dev/null || echo "STA starts when halow0 appears"
    fi
    ;;
  dhcp-reserve)
    RES=/etc/dnsmasq.d/halow-reservations.conf
    sub=${2:-list}
    case "$sub" in
      list) grep -oP "dhcp-host=\K.*" "$RES" 2>/dev/null || echo "(none)" ;;
      add)
        shift 2; MAC=""; IP=""; NAME=""
        for kv in "$@"; do case "${kv%%=*}" in
          mac) MAC=${kv#*=};; ip) IP=${kv#*=};; name) NAME=${kv#*=};; esac; done
        [[ "$MAC" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]] || { echo "bad mac"; exit 1; }
        [[ "$IP" =~ ^10\.117\.0\.[0-9]+$ ]] || { echo "ip must be 10.117.0.x"; exit 1; }
        [[ -z "$NAME" || "$NAME" =~ ^[A-Za-z0-9-]+$ ]] || { echo "bad name"; exit 1; }
        sudo touch "$RES"
        sudo sed -i "/dhcp-host=${MAC}/Id" "$RES"
        echo "dhcp-host=${MAC},${IP}${NAME:+,$NAME}" | sudo tee -a "$RES" >/dev/null
        sudo systemctl restart dnsmasq && echo "reserved ${IP} for ${MAC}"
        ;;
      del)
        shift 2; MAC=${1#mac=}
        [[ "$MAC" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]] || { echo "bad mac"; exit 1; }
        sudo sed -i "/dhcp-host=${MAC}/Id" "$RES" 2>/dev/null
        sudo systemctl restart dnsmasq && echo "released ${MAC}"
        ;;
      *) echo "usage: halowctl dhcp-reserve list|add mac= ip= [name=]|del mac="; exit 1 ;;
    esac
    ;;
  capture)
    SECS=${2:-10}
    [[ "$SECS" =~ ^[0-9]+$ ]] && [ "$SECS" -ge 3 ] && [ "$SECS" -le 30 ] || { echo "seconds 3-30"; exit 1; }
    OUT=/var/lib/halow/capture.pcap
    # timeout exits 124 when it ends a timed capture — the NORMAL case on
    # a quiet interface (only a 5000-frame cap exits 0); don't let set -e
    # turn a successful capture into an API 500
    sudo timeout "$SECS" tcpdump -i "${HALOW_IF:-halow0}" -c 5000 -w "$OUT" 2>&1 | tail -2 || true
    sudo chmod 644 "$OUT" 2>/dev/null
    ls -la "$OUT" 2>/dev/null || echo "no capture produced"
    ;;
  rate)
    P=/sys/module/morse/parameters
    case "${2:-show}" in
      show)
        echo "enable_fixed_rate=$(cat $P/enable_fixed_rate) fixed_mcs=$(cat $P/fixed_mcs) fixed_bw=$(cat $P/fixed_bw)"
        echo "NOTE: experimental test knobs; runtime effect unverified — restart halow-ap after changing, and always 'rate auto' + restart to restore (a control that drifts is the bug)"
        ;;
      auto) echo 0 | sudo tee $P/enable_fixed_rate >/dev/null && echo "fixed rate off" ;;
      set)
        shift 2
        for kv in "$@"; do
          k=${kv%%=*}; v=${kv#*=}
          [[ "$v" =~ ^[0-9]+$ ]] || { echo "numeric values only"; exit 1; }
          case "$k" in
            mcs) echo "$v" | sudo tee $P/fixed_mcs >/dev/null ;;
            bw)  echo "$v" | sudo tee $P/fixed_bw >/dev/null ;;
            *) echo "unknown key $k (mcs|bw)"; exit 1 ;;
          esac
        done
        echo 1 | sudo tee $P/enable_fixed_rate >/dev/null
        echo "fixed rate on: $(cat $P/fixed_mcs) mcs, bw code $(cat $P/fixed_bw) — restart halow-ap to apply"
        ;;
      *) echo "usage: halowctl rate show|set mcs=N bw=N|auto"; exit 1 ;;
    esac
    ;;
  diff)
    REPO=${2:-/home/pi/mesh-halow-raspberry-pi}
    rc=0
    for pair in "config/halow-profiles.json:/etc/halow/halow-profiles.json" \
                "config/pinned-scan.json:/etc/halow/pinned-scan.json" \
                "config/nftables-halow.conf:/etc/halow/nftables-halow.conf" \
                "config/morse.conf:/etc/modprobe.d/morse.conf"; do
      r="$REPO/${pair%%:*}"; l="${pair#*:}"
      if ! diff -q "$r" "$l" >/dev/null 2>&1; then
        echo "DRIFT: $l vs $r"; diff -u "$r" "$l" 2>&1 | head -15; rc=1
      fi
    done
    # env: compare key sets only, never values (the passphrase lives there)
    comm -3 <(grep -oP "^[A-Z_]+(?==)" "$REPO/config/halow.env.example" | sort) \
            <(sudo grep -oP "^[A-Z_]+(?==)" /etc/halow/halow.env | sort) | \
      sed "s/^\t/extra key on device: /; s/^[^ \t]/missing key on device: &/" | grep . && rc=1
    [ $rc -eq 0 ] && echo "no drift"
    exit $rc
    ;;
  backup)
    # Encrypted off-device backup of gateway IDENTITY + operator state.
    # Passphrase: HALOW_BACKUP_PASSPHRASE env, else stdin (never argv).
    # Plaintext staging lives in /run (tmpfs) — never the SD.
    BP=${HALOW_BACKUP_PASSPHRASE:-$(head -c 256)}
    [ "${#BP}" -ge 12 ] || { echo "passphrase must be at least 12 chars"; exit 1; }
    SET="etc/halow/halow.env etc/halow/ui.conf etc/halow/nodes.json
         etc/halow/ui-key.pem etc/halow/ui-cert.pem
         etc/halow/halow-profiles.json etc/halow/pinned-scan.json
         etc/halow/nftables-halow.conf etc/halow/forwards.json
         etc/modprobe.d/morse.conf etc/dnsmasq.d/halow.conf
         etc/dnsmasq.d/halow-reservations.conf"
    STG=$(sudo mktemp -d /run/halow-backup.XXXX); sudo chmod 700 "$STG"
    # collect only files that exist; build the manifest with real modes/owners
    PRESENT=""
    for f in $SET; do [ -e "/$f" ] && PRESENT="$PRESENT $f"; done
    sudo env PRESENT="$PRESENT" DRIVER_TAG=mm6108-2.0.1 python3 - "$STG" <<'PY'
import hashlib, json, os, pwd, grp, subprocess, sys
stg = sys.argv[1]
files = []
for f in os.environ["PRESENT"].split():
    p = "/" + f
    st = os.stat(p)
    files.append({"path": f,
                  "sha256": hashlib.sha256(open(p, "rb").read()).hexdigest(),
                  "mode": oct(st.st_mode & 0o777)[2:].zfill(4),
                  "owner": f"{pwd.getpwuid(st.st_uid).pw_name}:"
                           f"{grp.getgrgid(st.st_gid).gr_name}"})
m = {"format": 1,
     "created_at": subprocess.run(["date","-Is"],capture_output=True,text=True).stdout.strip(),
     "hostname": os.uname().nodename, "kernel": os.uname().release,
     "driver_tag": os.environ["DRIVER_TAG"], "files": files}
open(os.path.join(stg, "manifest.json"), "w").write(json.dumps(m, indent=1))
PY
    sudo sh -c 'cd / && cp --parents -a '"$PRESENT"' "$1"' _ "$STG/" 2>/dev/null
    OUTDIR=/var/lib/halow/backup
    sudo mkdir -p "$OUTDIR"; sudo chmod 750 "$OUTDIR"; sudo chgrp halow-ui "$OUTDIR"
    OUT="$OUTDIR/gateway-backup-$(date +%Y%m%d-%H%M%S).tar.gpg"
    # tar into the tmpfs staging dir, then gpg with the passphrase on STDIN
    # (not argv, not a herestring). Plaintext tar lives only in /run tmpfs.
    sudo sh -c 'cd "$1" && tar -cz manifest.json '"$PRESENT"' > archive.tar.gz' _ "$STG"
    printf '%s' "$BP" | sudo gpg --batch --pinentry-mode loopback --passphrase-fd 0 \
      --symmetric --cipher-algo AES256 -o "$OUT" "$STG/archive.tar.gz"
    sudo rm -rf "$STG"
    SZ=$(stat -c%s "$OUT")
    [ "$SZ" -le 1048576 ] || { echo "archive $SZ bytes > 1MB cap — something wrong got included"; sudo rm -f "$OUT"; exit 1; }
    # test-decrypt so a mistyped passphrase is caught NOW, not at disaster time
    N=$(printf '%s' "$BP" | sudo gpg --batch --pinentry-mode loopback --passphrase-fd 0 -d "$OUT" 2>/dev/null | tar -tz | wc -l)
    EXP=$(( $(echo $PRESENT | wc -w) + 1 ))
    [ "$N" = "$EXP" ] || { echo "test-decrypt FAILED ($N of $EXP members) — passphrase or archive bad"; sudo rm -f "$OUT"; exit 1; }
    sudo chmod 640 "$OUT"; sudo chgrp halow-ui "$OUT"
    # retention: keep newest 5
    sudo sh -c 'ls -1t /var/lib/halow/backup/gateway-backup-*.tar.gpg 2>/dev/null | tail -n +6 | xargs -r rm -f'
    echo "file=$(basename "$OUT") bytes=$SZ sha256=$(sudo sha256sum "$OUT" | cut -d" " -f1)"
    ;;
  restore)
    # CLI-only (NOT in sudoers). Runs as root; staging in /run (tmpfs).
    TAR=${2:?usage: halowctl restore <tarball> [--confirm]}
    CONFIRM=0; [ "${3:-}" = --confirm ] && CONFIRM=1
    [ -f "$TAR" ] || { echo "no such file: $TAR"; exit 1; }
    BP=${HALOW_BACKUP_PASSPHRASE:-$(head -c 256)}
    STG=$(mktemp -d /run/halow-restore.XXXX); chmod 700 "$STG"
    trap 'rm -rf "$STG"' EXIT
    if ! printf '%s' "$BP" | gpg --batch --pinentry-mode loopback --passphrase-fd 0 -d "$TAR" 2>/dev/null | tar -C "$STG" -xz; then
      echo "decrypt/extract failed — wrong passphrase or corrupt archive"; exit 1
    fi
    # validate manifest, sha256 every member, reject bad paths, compute diffs.
    # '|| rc=$?' both captures the code AND stops set -e aborting the script.
    rc=0
    env CONFIRM="$CONFIRM" python3 - "$STG" <<'PY' || rc=$?
import hashlib, json, os, sys
stg = sys.argv[1]
try:
    m = json.load(open(os.path.join(stg, "manifest.json")))
except Exception as e:
    sys.exit(f"no valid manifest: {e}")
if m.get("format") != 1:
    sys.exit(f"unknown backup format {m.get('format')}")
differ = []
for f in m["files"]:
    p = f["path"]
    if p.startswith("/") or ".." in p.split("/"):
        sys.exit(f"unsafe path in archive: {p}")
    src = os.path.join(stg, p)
    if not os.path.isfile(src):
        sys.exit(f"manifest lists {p} but it is missing from the archive")
    if hashlib.sha256(open(src, "rb").read()).hexdigest() != f["sha256"]:
        sys.exit(f"sha256 mismatch on {p} — archive corrupt")
    dst = "/" + p
    live = (open(dst, "rb").read() if os.path.isfile(dst) else None)
    if live is None or hashlib.sha256(live).hexdigest() != f["sha256"]:
        differ.append(p)
if not differ:
    print("no changes")
    sys.exit(3)  # sentinel: idempotent no-op
if os.environ["CONFIRM"] != "1":
    sys.stderr.write("REFUSED: these files differ from the archive "
                     "(re-run with --confirm to overwrite):\n  "
                     + "\n  ".join(differ) + "\n")
    sys.exit(2)
print("\n".join(differ))
PY
    # NOTE: no 'rc=$?' here — it would capture the '|| rc=$?' assignment's
    # own success (0) and clobber the sentinel. rc is already set above.
    if [ $rc -eq 2 ]; then exit 2; fi              # refused, no --confirm
    if [ $rc -eq 3 ]; then trap - EXIT; rm -rf "$STG"; exit 0; fi  # no-op
    [ $rc -eq 0 ] || exit $rc                       # any other failure
    # install each file atomically with the manifest's mode/owner
    sudo python3 - "$STG" <<'PY'
import json, os, shutil, sys, tempfile
stg = sys.argv[1]
m = json.load(open(os.path.join(stg, "manifest.json")))
for f in m["files"]:
    src, dst = os.path.join(stg, f["path"]), "/" + f["path"]
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = dst + ".rtmp"
    shutil.copyfile(src, tmp)
    os.chmod(tmp, int(f["mode"], 8))
    u, g = f["owner"].split(":")
    shutil.chown(tmp, u, g)
    os.replace(tmp, dst)
    print("restored", dst)
PY
    /usr/local/bin/halowctl gen >/dev/null 2>&1 || true
