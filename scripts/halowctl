#!/bin/bash
# halowctl — HaLow AP control for the Pi gateway.
#   halowctl status            chip, interface, AP state, stations
#   halowctl profiles          list tuning profiles and the active one
#   halowctl set-profile NAME  switch profile (regenerates conf, restarts AP)
#   halowctl set KEY=VAL ...   override channel=N width=M ssid=S (persisted)
#   halowctl gen               regenerate hostapd conf from env+profile
#   halowctl stations          associated STA dump
#   halowctl restart|stop      control the AP service
# Config: /etc/halow/halow.env (+ halow-profiles.json alongside this repo copy)
set -euo pipefail

ENV=/etc/halow/halow.env
PROFILES=/etc/halow/halow-profiles.json
CONF=/etc/halow/hostapd_s1g.conf
[ -f "$ENV" ] || { echo "missing $ENV (copy config/halow.env.example)"; exit 1; }
# shellcheck disable=SC1090
. "$ENV"

jqp() { python3 -c "import json,sys;d=json.load(open('$PROFILES'));print($1)"; }

resolve() { # -> CH OP WIDTH PRIM
  local prof=${HALOW_PROFILE:-$(jqp "d['default']")}
  CH=$(jqp "d['profiles']['$prof']['channel']")
  OP=$(jqp "d['profiles']['$prof']['op_class']")
  WIDTH=$(jqp "d['profiles']['$prof']['width_mhz']")
  PRIM=$(jqp "d['profiles']['$prof']['prim_chwidth']")
  # explicit overrides win; op_class re-derived from width
  if [ -n "${HALOW_CHANNEL:-}" ]; then CH=$HALOW_CHANNEL; fi
  if [ -n "${HALOW_WIDTH:-}" ]; then
    WIDTH=$HALOW_WIDTH
    case "$WIDTH" in
      1) OP=68; PRIM=0;; 2) OP=69; PRIM=1;; 4) OP=70; PRIM=1;; 8) OP=71; PRIM=1;;
      *) echo "width must be 1|2|4|8"; exit 1;;
    esac
  fi
}

gen() {
  resolve
  umask 077
  cat > "$CONF" <<EOF
# Generated by halowctl $(date -Is) — do not edit; edit $ENV instead.
interface=${HALOW_IF:-halow0}
driver=nl80211
ssid=${HALOW_SSID}
ieee80211ah=1
channel=${CH}
op_class=${OP}
country_code=${HALOW_COUNTRY:-US}
s1g_prim_chwidth=${PRIM}
wpa=2
wpa_key_mgmt=SAE
ieee80211w=2
sae_password=${HALOW_PASSPHRASE}
ctrl_interface=/var/run/hostapd_s1g
EOF
  echo "generated $CONF: ${HALOW_SSID} ch=$CH op_class=$OP width=${WIDTH}MHz"
}

case "${1:-status}" in
  gen) gen ;;
  profiles)
    active=${HALOW_PROFILE:-$(jqp "d['default']")}
    python3 - "$PROFILES" "$active" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); act=sys.argv[2]
for n,p in d['profiles'].items():
    m=' *' if n==act else '  '
    print(f"{m}{n:11s} {p['width_mhz']}MHz ch{p['channel']:>3} op{p['op_class']}  {p['phy_note']}")
PY
    ;;
  set-profile)
    n=${2:?usage: halowctl set-profile NAME}
    jqp "d['profiles']['$n']" >/dev/null || { echo "unknown profile $n"; exit 1; }
    sudo sed -i "s/^HALOW_PROFILE=.*/HALOW_PROFILE=$n/; s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=/; s/^HALOW_WIDTH=.*/HALOW_WIDTH=/" "$ENV"
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  set)
    shift
    for kv in "$@"; do
      k=${kv%%=*}; v=${kv#*=}
      case "$k" in
        channel) sudo sed -i "s/^HALOW_CHANNEL=.*/HALOW_CHANNEL=$v/" "$ENV";;
        width)   sudo sed -i "s/^HALOW_WIDTH=.*/HALOW_WIDTH=$v/" "$ENV";;
        ssid)    sudo sed -i "s/^HALOW_SSID=.*/HALOW_SSID=$v/" "$ENV";;
        *) echo "unknown key $k (channel|width|ssid)"; exit 1;;
      esac
    done
    sudo "$0" gen && sudo systemctl restart halow-ap
    ;;
  stations)
    iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null || echo "no stations / interface down"
    ;;
  restart) sudo systemctl restart halow-ap ;;
  stop) sudo systemctl stop halow-ap ;;
  status)
    echo "== interface"; ip -br addr show "${HALOW_IF:-halow0}" 2>/dev/null || echo "  ${HALOW_IF:-halow0}: ABSENT (driver not probed?)"
    echo "== AP service"; systemctl is-active halow-ap 2>/dev/null || true
    echo "== config"; resolve; echo "  ssid=${HALOW_SSID} profile=${HALOW_PROFILE:-default} ch=$CH op=$OP width=${WIDTH}MHz"
    echo "== chip"; dmesg | grep -iE "morse.*(fw|chip)" | tail -2 || true
    echo "== stations"; iw dev "${HALOW_IF:-halow0}" station dump 2>/dev/null | grep -E "^Station|signal:|tx bitrate|rx bitrate" || echo "  none"
    ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
