#!/usr/bin/env python3
"""Gateway metrics sampler + self-healing monitor. Runs as root once a
minute via halow-mon.timer.

Samples into /var/lib/halow/metrics.jsonl (2-day ring) and heals with
bounded actions, counting every intervention in mon-state.json — detect
the event, classify separately, and never hide how often healing fired.
Reachability is tested with ICMP to the upstream gateway, not by asking
the driver how it feels (the bench's dead-association lesson)."""
import json
import os
import subprocess
import time

STATE_DIR = "/var/lib/halow"
METRICS = os.path.join(STATE_DIR, "metrics.jsonl")
STATE = os.path.join(STATE_DIR, "mon-state.json")
RING_LINES = 2880  # 2 days at 1/min
UPSTREAM = "192.168.50.1"
DISK_LOW_MB = 512  # SD low-water; mirrored in halow_ui.py

DEFAULTS = {"ap_restarts": 0, "dnsmasq_restarts": 0, "eth0_bounces": 0,
            "ap_down_streak": 0, "upstream_down_streak": 0,
            "last_eth0_bounce": 0, "disk_low": False, "disk_low_events": 0,
            "actions": []}


def sh(cmd, timeout=15):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True,
                              text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""


def atomic_write(path, data, mode=0o644):
    """tmp in same dir + fsync + os.replace — a brownout mid-write leaves
    the OLD file intact, never a truncated one (meshdata.py convention;
    fsync added because the threat here is power loss, not process crash).
    The tmp MUST be a sibling: os.replace across filesystems is EXDEV."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)  # mode set BEFORE it becomes the live file
    os.replace(tmp, path)


def load_state():
    # defaults-merge: a torn-but-valid partial file must never KeyError
    # the healer; a corrupt file falls back whole.
    try:
        return {**DEFAULTS, **json.load(open(STATE))}
    except Exception:
        return dict(DEFAULTS)


def act(state, key, note):
    state[key] += 1
    state["actions"] = (state["actions"] + [
        {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "action": note}])[-20:]
    subprocess.run(["logger", "-t", "halow-mon", note])


def main():
    st = load_state()
    now = int(time.time())

    halow_present = os.path.isdir("/sys/class/net/halow0")
    ap_beaconing = "type AP" in sh("iw dev halow0 info")
    ap_wanted = halow_present and \
        sh("systemctl is-enabled halow-ap") in ("enabled", "static")
    dnsmasq_ok = sh("systemctl is-active dnsmasq") == "active"
    upstream_ok = subprocess.run(
        ["ping", "-c", "1", "-W", "2", "-n", UPSTREAM],
        capture_output=True).returncode == 0

    # --- heal, bounded ---
    if ap_wanted and not ap_beaconing:
        st["ap_down_streak"] += 1
        if st["ap_down_streak"] >= 2:  # two consecutive minutes, not a blip
            act(st, "ap_restarts", "AP not beaconing 2 samples - restarting halow-ap")
            subprocess.run(["systemctl", "restart", "halow-ap"])
            st["ap_down_streak"] = 0
    else:
        st["ap_down_streak"] = 0

    if not dnsmasq_ok:
        act(st, "dnsmasq_restarts", "dnsmasq inactive - restarting")
        subprocess.run(["systemctl", "restart", "dnsmasq"])

    if not upstream_ok:
        st["upstream_down_streak"] += 1
        if (st["upstream_down_streak"] >= 5
                and now - st["last_eth0_bounce"] > 1800):
            act(st, "eth0_bounces",
                "upstream unreachable 5 samples - bouncing eth0-static")
            subprocess.run(["nmcli", "con", "up", "eth0-static"],
                           capture_output=True)
            st["last_eth0_bounce"] = now
            st["upstream_down_streak"] = 0
    else:
        st["upstream_down_streak"] = 0

    # --- sample ---
    thr = sh("vcgencmd get_throttled")
    vfs = os.statvfs("/")
    free_mb = vfs.f_bavail * vfs.f_frsize // 1048576
    sample = {
        "t": now,
        "load1": float(open("/proc/loadavg").read().split()[0]),
        "temp_c": round(int(open(
            "/sys/class/thermal/thermal_zone0/temp").read()) / 1000, 1),
        "mem_avail_kb": next(int(x.split()[1]) for x in
                             open("/proc/meminfo") if "MemAvailable" in x),
        "throttled": thr.split("=")[-1] if "=" in thr else None,
        "stations": sh("iw dev halow0 station dump").count("Station"),
        "disk_free_mb": free_mb,
        "ap": ap_beaconing, "dnsmasq": dnsmasq_ok, "upstream": upstream_ok,
    }
    # disk low-water: edge-triggered — one logged event per crossing,
    # never one per minute
    low = free_mb < DISK_LOW_MB
    if low and not st.get("disk_low"):
        act(st, "disk_low_events",
            f"disk free {free_mb}MB below {DISK_LOW_MB}MB low-water")
    st["disk_low"] = low
    with open(METRICS, "a") as f:
        f.write(json.dumps(sample) + "\n")

    # per-station link samples — the raw material for a measured
    # TRANSPORT_HALOW metric (rate and delivery, never datasheet numbers)
    dump = sh("iw dev halow0 station dump")
    if dump:
        stations_log = os.path.join(STATE_DIR, "stations.jsonl")
        cur = None
        entries = []
        for line in dump.splitlines():
            line = line.strip()
            if line.startswith("Station"):
                cur = {"t": now, "mac": line.split()[1]}
                entries.append(cur)
            elif cur is not None and ":" in line:
                k, v = [x.strip() for x in line.split(":", 1)]
                if k == "signal":
                    cur["signal_dbm"] = int(v.split()[0])
                elif k == "tx bitrate":
                    cur["tx_mbps"] = float(v.split()[0])
                elif k == "rx bitrate":
                    cur["rx_mbps"] = float(v.split()[0])
                elif k in ("tx packets", "tx retries", "tx failed"):
                    cur[k.replace(" ", "_")] = int(v)
        with open(stations_log, "a") as f:
            for e in entries:
                f.write(json.dumps(e) + "\n")
        try:
            lines = open(stations_log).readlines()
            if len(lines) > RING_LINES * 4:
                atomic_write(stations_log, "".join(lines[-RING_LINES * 2:]))
        except OSError:
            pass
        os.chmod(stations_log, 0o644)

    # ring prune (cheap: only when oversized)
    try:
        lines = open(METRICS).readlines()
        if len(lines) > RING_LINES + 200:
            atomic_write(METRICS, "".join(lines[-RING_LINES:]))
    except OSError:
        pass
    os.chmod(METRICS, 0o644)

    atomic_write(STATE, json.dumps(st))


if __name__ == "__main__":
    main()
