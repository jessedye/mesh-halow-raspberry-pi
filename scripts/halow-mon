#!/usr/bin/env python3
"""Gateway metrics sampler + self-healing monitor. Runs as root once a
minute via halow-mon.timer.

Samples into /var/lib/halow/metrics.jsonl (2-day ring) and heals with
bounded actions, counting every intervention in mon-state.json — detect
the event, classify separately, and never hide how often healing fired.
Reachability is tested with ICMP to the upstream gateway, not by asking
the driver how it feels (the bench's dead-association lesson)."""
import json
import os
import shutil
import subprocess
import time

STATE_DIR = "/var/lib/halow"
METRICS = os.path.join(STATE_DIR, "metrics.jsonl")
STATE = os.path.join(STATE_DIR, "mon-state.json")
HEALTH = os.path.join(STATE_DIR, "station-health.json")
EVENTS_LOG = os.path.join(STATE_DIR, "station-events.log")
RUNGCOST = os.path.join(STATE_DIR, "rungcost-state.json")
RING_LINES = 2880  # 2 days at 1/min
UPSTREAM = "192.168.50.1"
DISK_LOW_MB = 512  # SD low-water; mirrored in halow_ui.py

# --- station health ladder (roadmap 18) ---
LEASES = "/var/lib/misc/dnsmasq.leases"
RESERVATIONS = "/etc/dnsmasq.d/halow-reservations.conf"
NODES_JSON = "/etc/halow/nodes.json"  # tokens live here: read mac+interval ONLY
HOLD_MULTIPLIER = 3     # nodewatch.py:52 — same constant, same justification
DEFAULT_INTERVAL_S = 3600  # nodewatch's conservative fallback: under-alert
HOLD_SAMPLES = 2        # the healer's two-samples-not-a-blip rule
ARPING_W = 3
PING_W = 5   # S1G power-save buffers frames at the AP; a slow answer is normal
WALK_BUDGET_S = 30      # whole walk wall-clock cap; must beat the 60s timer
PRUNE_UNKNOWN_S = 86400

DEFAULTS = {"ap_restarts": 0, "dnsmasq_restarts": 0, "eth0_bounces": 0,
            "ap_down_streak": 0, "upstream_down_streak": 0,
            "last_eth0_bounce": 0, "disk_low": False, "disk_low_events": 0,
            "actions": []}


def sh(cmd, timeout=15):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True,
                              text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""


def atomic_write(path, data, mode=0o644):
    """tmp in same dir + fsync + os.replace — a brownout mid-write leaves
    the OLD file intact, never a truncated one (meshdata.py convention;
    fsync added because the threat here is power loss, not process crash).
    The tmp MUST be a sibling: os.replace across filesystems is EXDEV."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)  # mode set BEFORE it becomes the live file
    os.replace(tmp, path)


def load_state():
    # defaults-merge: a torn-but-valid partial file must never KeyError
    # the healer; a corrupt file falls back whole.
    try:
        return {**DEFAULTS, **json.load(open(STATE))}
    except Exception:
        return dict(DEFAULTS)


def act(state, key, note):
    state[key] += 1
    state["actions"] = (state["actions"] + [
        {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "action": note}])[-20:]
    subprocess.run(["logger", "-t", "halow-mon", note])


def parse_station_dump(dump):
    """One parse for both the metrics sample and the health walk.
    MACs are lowercased here, the single ingestion point."""
    out, cur = [], None
    for line in dump.splitlines():
        line = line.strip()
        if line.startswith("Station"):
            cur = {"mac": line.split()[1].lower()}
            out.append(cur)
        elif cur is not None and ":" in line:
            k, v = [x.strip() for x in line.split(":", 1)]
            try:
                if k == "signal":
                    cur["signal_dbm"] = int(v.split()[0])
                elif k == "tx bitrate":
                    cur["tx_mbps"] = float(v.split()[0])
                elif k == "rx bitrate":
                    cur["rx_mbps"] = float(v.split()[0])
                elif k == "inactive time":
                    cur["inactive_ms"] = int(v.split()[0])
                elif k in ("tx packets", "tx retries", "tx failed"):
                    cur[k.replace(" ", "_")] = int(v)
            except (ValueError, IndexError):
                pass
    return out


def read_leases():
    out = {}
    try:
        for line in open(LEASES):
            p = line.split()
            if len(p) >= 3:
                out[p[1].lower()] = p[2]
    except OSError:
        pass
    return out


def read_reservations():
    out = {}
    try:
        for line in open(RESERVATIONS):
            if line.startswith("dhcp-host="):
                p = line.strip()[len("dhcp-host="):].split(",")
                if len(p) >= 2:
                    out[p[0].lower()] = p[1]
    except OSError:
        pass
    return out


def read_neigh():
    """[{ip, mac, state}] from the kernel neighbor cache on halow0."""
    out = []
    try:
        raw = subprocess.run(["ip", "-j", "neigh", "show", "dev", "halow0"],
                             capture_output=True, text=True, timeout=5).stdout
        for n in json.loads(raw or "[]"):
            if n.get("dst") and n.get("lladdr"):
                out.append({"ip": n["dst"], "mac": n["lladdr"].lower(),
                            "state": (n.get("state") or [""])[0]})
    except Exception:
        pass
    return out


def known_intervals():
    """mac -> expected_interval_s from nodes.json. This is the ONLY reader
    of that file here: it holds bearer tokens, so extract two keys and
    drop the rest — nothing else may reach state, logs, or the API."""
    out = {}
    try:
        for n in json.load(open(NODES_JSON)):
            mac = str(n.get("mac", "")).lower()
            if mac:
                try:
                    out[mac] = int(n.get("expected_interval_s",
                                         DEFAULT_INTERVAL_S))
                except (TypeError, ValueError):
                    out[mac] = DEFAULT_INTERVAL_S
    except Exception:
        pass
    return out


def classify(assoc, ip, arp_ok, icmp_ok, last_seen_assoc, interval_s, now,
             known):
    """Pure ladder classifier — no subprocess calls, unit-testable.
    Present stations: highest rung achieved. Absent stations: freshness
    only (never probed) — quiet is healthy inside 3x the node's own
    interval, the nodewatch rule."""
    if assoc:
        if ip is None:
            return "assoc-no-lease", "no IP in lease/reservation/neigh"
        if icmp_ok:
            return "reachable", ""
        if arp_ok:
            return "arp-no-icmp", "L2 answers, IP stack does not"
        return "leased-no-arp", "the dead-association trap"
    if last_seen_assoc is None:
        return "never-seen", ""
    if now - last_seen_assoc <= HOLD_MULTIPLIER * interval_s:
        return "quiet", ""
    return "lost", f"silent past {HOLD_MULTIPLIER}x{interval_s}s"


def rungcost_step(parsed, now):
    """Measured TRANSPORT_HALOW rung cost (roadmap 20): one window per
    run through halow_rungcost's pure logic. Runs even with zero
    stations — all-absent is a result, not a skip. Corrupt state means
    fresh start, never a wedged monitor (#22's lesson)."""
    import sys
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import halow_rungcost as rc
    try:
        state = json.load(open(RUNGCOST))
        if not isinstance(state.get("stations"), dict):
            raise ValueError
    except Exception:
        state = {"v": 1, "stations": {}}
    stations = state["stations"]
    seen = {e["mac"]: e for e in parsed}
    for mac in set(stations) | set(seen):
        entry = stations.get(mac)
        if entry is None:
            entry = stations[mac] = rc.fresh_entry(now)
        cur = seen.get(mac)
        v, w = rc.evaluate_window(entry.get("last"),
                                  {**cur, "t": now} if cur else None)
        rc.step(entry, v, w, now)
        if cur is not None:
            # store the new baseline on every sighting — including after
            # a reset verdict (reassociation), which is the point
            entry["last"] = {"t": now, **{k: cur[k] for k in
                             ("tx_packets", "tx_retries", "tx_failed",
                              "tx_mbps", "signal_dbm") if k in cur}}
            entry["last_seen"] = now
    for mac in [m for m, e in stations.items()
                if now - e.get("last_seen", 0) > 172800]:
        del stations[mac]   # 2-day eviction, the stations.jsonl horizon
    while len(stations) > 64:
        del stations[min(stations, key=lambda m:
                         stations[m].get("last_seen", 0))]
    state["t"] = now
    atomic_write(RUNGCOST, json.dumps(state))


def load_health():
    try:
        h = json.load(open(HEALTH))
        h.setdefault("_cursor", 0)
        h.setdefault("stations", {})
        return h
    except Exception:
        return {"_cursor": 0, "stations": {}}


def append_events(lines):
    if not lines:
        return
    with open(EVENTS_LOG, "a") as f:
        for ln in lines:
            f.write(ln + "\n")
    # two writers, two UIDs: if root created the file, halow-ui's hostapd
    # hook would be locked out of its own log — hand it back
    try:
        if os.stat(EVENTS_LOG).st_uid == 0:
            os.chmod(EVENTS_LOG, 0o644)
            shutil.chown(EVENTS_LOG, "halow-ui", "halow-ui")
    except (OSError, LookupError):
        pass


def health_walk(parsed, now):
    """Walk associated MACs up the ladder (bounded), judge absent MACs by
    freshness, commit transitions with the two-sample hold. Returns the
    count of reachable stations for the metrics sample."""
    health = load_health()
    stations = health["stations"]
    leases, reservations = read_leases(), read_reservations()
    neigh = read_neigh()
    neigh_by_mac = {n["mac"]: n for n in neigh}
    intervals = known_intervals()
    known_macs = set(reservations) | set(intervals)
    assoc_macs = [e["mac"] for e in parsed]

    deadline = time.monotonic() + WALK_BUDGET_S
    order = sorted(assoc_macs)
    cur = health["_cursor"] % max(len(order), 1) if order else 0
    order = order[cur:] + order[:cur]
    events = []
    walked = set()

    def commit(mac, rec, new_state, detail, extra=""):
        old = rec["state"]
        rec["state"], rec["since"] = new_state, now
        rec["pending"], rec["pending_streak"] = None, 0
        rec["detail"] = detail
        if old is None and new_state in ("never-seen", "quiet"):
            return  # pre-association steady state: no event, no alarm
        if old == new_state:
            return
        tok = "HEALTH-" + new_state.upper().replace("_", "-")
        ip = rec.get("ip") or ""
        events.append(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {tok} {mac}"
                      f"{' ip=' + ip if ip else ''}"
                      f"{' was=' + old if old else ''}{extra}")

    def consider(mac, rec, new_state, detail):
        if new_state == rec["state"]:
            rec["pending"], rec["pending_streak"] = None, 0
            rec["detail"] = detail
            return
        immediate = (new_state == "reachable" or rec["state"] is None
                     or (rec["state"] == "quiet" and new_state == "lost"))
        if immediate:
            commit(mac, rec, new_state, detail)
            return
        if rec["pending"] == new_state:
            rec["pending_streak"] += 1
        else:
            rec["pending"], rec["pending_streak"] = new_state, 1
        if rec["pending_streak"] >= HOLD_SAMPLES:
            commit(mac, rec, new_state, detail, extra=f" held={HOLD_SAMPLES}")

    def fresh_rec():
        return {"state": None, "since": now, "pending": None,
                "pending_streak": 0, "last_seen_assoc": None, "ip": None,
                "ip_source": None, "known": False, "expected_interval_s":
                DEFAULT_INTERVAL_S, "stale_after_s":
                HOLD_MULTIPLIER * DEFAULT_INTERVAL_S,
                "rungs": {}, "arp_method": None, "probe_ms": None,
                "detail": ""}

    # --- present stations: up the ladder, under budget ---
    for mac in order:
        rec = stations.setdefault(mac, fresh_rec())
        rec["last_seen_assoc"] = now
        rec["known"] = mac in known_macs
        iv = intervals.get(mac, DEFAULT_INTERVAL_S)
        rec["expected_interval_s"] = iv
        rec["stale_after_s"] = HOLD_MULTIPLIER * iv
        if time.monotonic() > deadline:
            rec["detail"] = "walk=skipped"
            continue
        walked.add(mac)
        t0 = time.monotonic()
        ip, src = None, None
        for cand, s in ((leases.get(mac), "lease"),
                        (reservations.get(mac), "reservation"),
                        ((neigh_by_mac.get(mac) or {}).get("ip"), "neigh")):
            if cand:
                ip, src = cand, s
                break
        arp_ok = icmp_ok = False
        arp_method = None
        if ip:
            try:
                arp_ok = subprocess.run(
                    ["arping", "-c", "2", "-w", str(ARPING_W), "-I",
                     "halow0", ip], capture_output=True,
                    timeout=ARPING_W + 3).returncode == 0
                arp_method = "arping"
            except FileNotFoundError:
                # degraded, not fatal: cache REACHABLE reflects recent
                # kernel traffic, not a probe this pass — marked, never
                # silent
                n = neigh_by_mac.get(mac)
                arp_ok = bool(n and n["state"] == "REACHABLE"
                              and n["ip"] == ip)
                arp_method = "cache"
            except Exception:
                arp_method = "arping"
            try:
                icmp_ok = subprocess.run(
                    ["ping", "-c", "1", "-W", str(PING_W), "-n", ip],
                    capture_output=True, timeout=PING_W + 3).returncode == 0
            except Exception:
                pass
        rec.update({"ip": ip, "ip_source": src, "arp_method": arp_method,
                    "probe_ms": int((time.monotonic() - t0) * 1000),
                    "rungs": {"assoc": True, "lease": ip is not None,
                              "arp": arp_ok, "icmp": icmp_ok}})
        state, detail = classify(True, ip, arp_ok, icmp_ok, now,
                                 iv, now, rec["known"])
        consider(mac, rec, state, detail)

    # advance the round-robin cursor past what we walked
    if order and len(walked) < len(order):
        health["_cursor"] = (cur + len(walked)) % len(order)
    else:
        health["_cursor"] = 0

    # --- absent stations: freshness only, never probed ---
    assoc_set = set(assoc_macs)
    for mac in list(set(stations) | known_macs):
        if mac in assoc_set:
            continue
        rec = stations.setdefault(mac, fresh_rec())
        rec["known"] = mac in known_macs
        iv = intervals.get(mac, DEFAULT_INTERVAL_S)
        rec["expected_interval_s"] = iv
        rec["stale_after_s"] = HOLD_MULTIPLIER * iv
        rec["rungs"] = {}
        if not rec["known"] and rec["last_seen_assoc"] is not None:
            if rec["state"] != "gone":
                commit(mac, rec, "gone", "unknown mac disassociated")
            if now - rec["since"] > PRUNE_UNKNOWN_S:
                del stations[mac]
            continue
        state, detail = classify(False, None, False, False,
                                 rec["last_seen_assoc"], iv, now,
                                 rec["known"])
        consider(mac, rec, state, detail)

    append_events(events)
    atomic_write(HEALTH, json.dumps(health))
    return sum(1 for r in stations.values() if r["state"] == "reachable")


def main():
    st = load_state()
    now = int(time.time())

    halow_present = os.path.isdir("/sys/class/net/halow0")
    ap_beaconing = "type AP" in sh("iw dev halow0 info")
    ap_wanted = halow_present and \
        sh("systemctl is-enabled halow-ap") in ("enabled", "static")
    dnsmasq_ok = sh("systemctl is-active dnsmasq") == "active"
    upstream_ok = subprocess.run(
        ["ping", "-c", "1", "-W", "2", "-n", UPSTREAM],
        capture_output=True).returncode == 0

    # --- heal, bounded ---
    if ap_wanted and not ap_beaconing:
        st["ap_down_streak"] += 1
        if st["ap_down_streak"] >= 2:  # two consecutive minutes, not a blip
            act(st, "ap_restarts", "AP not beaconing 2 samples - restarting halow-ap")
            subprocess.run(["systemctl", "restart", "halow-ap"])
            st["ap_down_streak"] = 0
    else:
        st["ap_down_streak"] = 0

    if not dnsmasq_ok:
        act(st, "dnsmasq_restarts", "dnsmasq inactive - restarting")
        subprocess.run(["systemctl", "restart", "dnsmasq"])

    if not upstream_ok:
        st["upstream_down_streak"] += 1
        if (st["upstream_down_streak"] >= 5
                and now - st["last_eth0_bounce"] > 1800):
            act(st, "eth0_bounces",
                "upstream unreachable 5 samples - bouncing eth0-static")
            subprocess.run(["nmcli", "con", "up", "eth0-static"],
                           capture_output=True)
            st["last_eth0_bounce"] = now
            st["upstream_down_streak"] = 0
    else:
        st["upstream_down_streak"] = 0

    # --- station parse (once) + health ladder walk ---
    dump = sh("iw dev halow0 station dump")
    parsed = parse_station_dump(dump)
    try:
        sta_reachable = health_walk(parsed, now)
    except Exception as e:
        # the ladder must never take the sampler or the healer down with it
        subprocess.run(["logger", "-t", "halow-mon",
                        f"health walk failed: {e.__class__.__name__}: {e}"])
        sta_reachable = None
    try:
        rungcost_step(parsed, now)
    except Exception as e:
        subprocess.run(["logger", "-t", "halow-mon",
                        f"rungcost step failed: {e.__class__.__name__}: {e}"])

    # --- sample ---
    thr = sh("vcgencmd get_throttled")
    vfs = os.statvfs("/")
    free_mb = vfs.f_bavail * vfs.f_frsize // 1048576
    # time sync: mirrored parse of ui time_sync() — synced means a real
    # reference (not chrony's 7F7F0101 local holdover) with leap Normal
    tr = sh("chronyc -c tracking")
    trf = tr.strip().split(",") if tr and "," in tr else []
    time_synced = bool(trf) and trf[0].upper() != "7F7F0101" \
        and trf[-1] == "Normal"
    sample = {
        "t": now,
        "load1": float(open("/proc/loadavg").read().split()[0]),
        "temp_c": round(int(open(
            "/sys/class/thermal/thermal_zone0/temp").read()) / 1000, 1),
        "mem_avail_kb": next(int(x.split()[1]) for x in
                             open("/proc/meminfo") if "MemAvailable" in x),
        "throttled": thr.split("=")[-1] if "=" in thr else None,
        "stations": len(parsed),
        "sta_reachable": sta_reachable,
        "disk_free_mb": free_mb,
        "time_synced": time_synced,
        "ap": ap_beaconing, "dnsmasq": dnsmasq_ok, "upstream": upstream_ok,
    }
    # disk low-water: edge-triggered — one logged event per crossing,
    # never one per minute
    low = free_mb < DISK_LOW_MB
    if low and not st.get("disk_low"):
        act(st, "disk_low_events",
            f"disk free {free_mb}MB below {DISK_LOW_MB}MB low-water")
    st["disk_low"] = low
    with open(METRICS, "a") as f:
        f.write(json.dumps(sample) + "\n")

    # per-station link samples — the raw material for a measured
    # TRANSPORT_HALOW metric (rate and delivery, never datasheet numbers)
    if parsed:
        stations_log = os.path.join(STATE_DIR, "stations.jsonl")
        with open(stations_log, "a") as f:
            for e in parsed:
                f.write(json.dumps({"t": now, **e}) + "\n")
        try:
            lines = open(stations_log).readlines()
            if len(lines) > RING_LINES * 4:
                atomic_write(stations_log, "".join(lines[-RING_LINES * 2:]))
        except OSError:
            pass
        os.chmod(stations_log, 0o644)

    # ring prune (cheap: only when oversized)
    try:
        lines = open(METRICS).readlines()
        if len(lines) > RING_LINES + 200:
            atomic_write(METRICS, "".join(lines[-RING_LINES:]))
    except OSError:
        pass
    os.chmod(METRICS, 0o644)

    atomic_write(STATE, json.dumps(st))


if __name__ == "__main__":
    main()
