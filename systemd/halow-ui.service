[Unit]
Description=HaLow gateway web console
After=network.target

[Service]
# notify: the app's pet thread sends READY=1 only once it verifies itself
# serving (/healthz self-probe) and WATCHDOG=1 per verified probe — missed
# pets for 60 s SIGABRT the service and Restart=on-failure revives it.
Type=notify
NotifyAccess=main
WatchdogSec=60
ExecStart=/usr/bin/python3 /usr/local/lib/halow_ui.py
Restart=on-failure
RestartSec=5
User=halow-ui
# The UI shells out to a fixed set of privileged commands via sudoers.d/halow-ui.
# ProtectSystem=true (not full): the config API's halowctl mutations write
# /etc/halow and /etc/dnsmasq.d through sudo, which inherits this namespace.
NoNewPrivileges=no
ProtectSystem=true
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
