[Unit]
Description=HaLow gateway addressing, forwarding and NAT
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/halow/halow.env
# The interface exists only once the morse driver has probed the chip;
# wait for it briefly so boot ordering never races the SPI probe.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 20); do ip link show "$HALOW_IF" >/dev/null 2>&1 && exit 0; sleep 1; done; echo "$HALOW_IF absent, continuing (router-only)"'
ExecStart=/bin/sh -c 'ip link show "$HALOW_IF" >/dev/null 2>&1 && ip addr replace "$HALOW_ADDR" dev "$HALOW_IF" && ip link set "$HALOW_IF" up || true'
ExecStart=/usr/sbin/sysctl -qw net.ipv4.ip_forward=1
ExecStart=/usr/sbin/nft -f /etc/halow/nftables-halow.conf

[Install]
WantedBy=multi-user.target
