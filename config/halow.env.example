# /etc/halow/halow.env — HaLow AP identity and tuning.
# Copy to /etc/halow/halow.env and set the real passphrase there.
# The real file is NEVER committed (see .gitignore); mesh-v4 has leaked a
# PSK twice through "harmless" echoes — treat this file as radioactive.

HALOW_SSID=mesh
# WPA3/SAE passphrase the mesh nodes use to join:
HALOW_PASSPHRASE=CHANGE-ME
HALOW_COUNTRY=US
# ap = broadcast HALOW_SSID (default) | sta = join an existing HaLow network
# of that name. Switch with: halowctl mode ap|sta
HALOW_MODE=ap
# One of: long-range | mid-range | balanced | max-rate  (config/halow-profiles.json)
HALOW_PROFILE=balanced
# Optional overrides (empty = profile value). Valid pairs: see profiles json.
HALOW_CHANNEL=
HALOW_WIDTH=
# AP-side IP plan
HALOW_IF=halow0
HALOW_ADDR=10.117.0.1/24
HALOW_DHCP_START=10.117.0.10
HALOW_DHCP_END=10.117.0.200
# Interface NAT'd toward the LAN/upstream
WAN_IF=eth0
# Kernel-upgrade interlock (halow-kernel-guard): what to do when a kernel
# bump orphans morse.ko. rebuild = prebuilt restore -> driver rebuild ->
# apt-mark hold on failure. hold = never auto-build, just hold + alert.
HALOW_KERNEL_POLICY=rebuild
# Repo checkout on the Pi (prebuilt/ + install.sh live here)
HALOW_REPO_DIR=/home/pi/mesh-halow-raspberry-pi
# Fleet watcher (halow-watch): seconds between poll cycles (60-3600) and
# HTTPS deep-poll every Nth cycle per node (cheap plain-HTTP report
# otherwise — each HTTPS hit costs a node one of ~6 TLS sessions)
HALOW_WATCH_INTERVAL=120
HALOW_WATCH_DIAG_EVERY=10
# Bridged mode (halowctl role). gateway = today's role (halow0 AP +
# eth0 upstream NAT). bridge = the Pi is a remote extender: an UPLINK
# joins someone else's network as a client, a DOWNLINK serves local
# devices, NAT points at the uplink.
#   HALOW_BRIDGE_UPLINK=halow  halow0 STA joins another gateway's mesh SSID
#                       =wifi   wlan0 STA joins an upstream WiFi (nmcli
#                               profile bridge-uplink)
#   HALOW_BRIDGE_ETH=mgmt       eth0 stays the management LAN (default;
#                               downlink is the 2.4GHz mesh-2g AP)
#                    =downlink  eth0 serves DHCP to wired clients too
# The live switch reconfigures the interface you may be managing through,
# so 'halowctl role set-bridge' arms a dead-man rollback: unless
# 'halowctl role commit' runs within hold= seconds (default 300), the Pi
# restores the gateway role by itself.
HALOW_ROLE=gateway
HALOW_BRIDGE_UPLINK=halow
HALOW_BRIDGE_ETH=mgmt
# Battery-ready AP session knobs (halowctl set inactivity=|bss_max_idle=|
# max_idle=|dtim=). Empty = omit the conf line = hostapd default. These
# matter the day node power-save lands: a dozing STA can't ACK hostapd's
# poll inside the 3s disassoc window, so the 300s default kicks every
# sleeper. HALOW_MAX_IDLE_TU is in 1000-TU units (~1.024 s), NOT seconds —
# that is what hostapd compares against the STA's requested idle period.
# Battery preset (3x the node's 30-min check interval, grant the S1G
# long-idle, ~1s DTIM buffering):
#   halowctl set inactivity=5400 bss_max_idle=1 max_idle=5273 dtim=10
HALOW_AP_MAX_INACTIVITY=
HALOW_BSS_MAX_IDLE=
HALOW_MAX_IDLE_TU=
HALOW_DTIM_PERIOD=
