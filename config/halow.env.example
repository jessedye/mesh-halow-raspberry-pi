# /etc/halow/halow.env — HaLow AP identity and tuning.
# Copy to /etc/halow/halow.env and set the real passphrase there.
# The real file is NEVER committed (see .gitignore); mesh-v4 has leaked a
# PSK twice through "harmless" echoes — treat this file as radioactive.

HALOW_SSID=mesh-halow
# WPA3/SAE passphrase the mesh nodes use to join:
HALOW_PASSPHRASE=CHANGE-ME
HALOW_COUNTRY=US
# One of: long-range | mid-range | balanced | max-rate  (config/halow-profiles.json)
HALOW_PROFILE=balanced
# Optional overrides (empty = profile value). Valid pairs: see profiles json.
HALOW_CHANNEL=
HALOW_WIDTH=
# AP-side IP plan
HALOW_IF=halow0
HALOW_ADDR=10.117.0.1/24
HALOW_DHCP_START=10.117.0.10
HALOW_DHCP_END=10.117.0.200
# Interface NAT'd toward the LAN/upstream
WAN_IF=eth0
