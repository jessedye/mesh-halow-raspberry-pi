--- a/spi.c
+++ b/spi.c
@@ -14,6 +14,7 @@
 #include <linux/crc-itu-t.h>
 #include <linux/spi/spi.h>
 #include <linux/gpio.h>
+#include <linux/gpio/consumer.h>
 
 #include "morse.h"
